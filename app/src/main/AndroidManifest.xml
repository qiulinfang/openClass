<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ============================================ -->
    <!-- 权限声明 (Permissions) -->
    <!-- ============================================ -->

    <!-- 设备管理权限 (Device Admin Permissions) -->
    <!-- 用于Kiosk模式，管理设备管理员功能 -->
    <uses-permission
        android:name="android.permission.BIND_DEVICE_ADMIN"
        tools:ignore="ProtectedPermissions" />
    <uses-permission
        android:name="android.permission.MANAGE_DEVICE_ADMINS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!-- 系统级权限 (System-Level Permissions) -->
    <!-- 查询所有已安装应用，用于应用监控 -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <!-- 应用使用统计，用于监控应用使用情况 -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <!-- 系统悬浮窗权限，用于显示悬浮按钮和机器人 -->
    <uses-permission
        android:name="android.permission.SYSTEM_ALERT_WINDOW"
        android:required="true" />

    <!-- 任务管理权限 (Task Management Permissions) -->
    <!-- 获取任务列表和重新排序任务，用于Kiosk模式 -->
    <uses-permission android:name="android.permission.GET_TASKS" />
    <uses-permission android:name="android.permission.REORDER_TASKS" />

    <!-- 前台服务权限 (Foreground Service Permissions) -->
    <!-- 基础前台服务权限 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- 数据同步类型的前台服务 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- 媒体投影类型的前台服务 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <!-- 特殊用途类型的前台服务 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- 系统控制权限 (System Control Permissions) -->
    <!-- 唤醒锁，保持设备唤醒 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- 禁用锁屏 -->
    <uses-permission android:name="android.permission.DISABLE_KEYGUARD" />
    <!-- 展开状态栏 -->
    <uses-permission android:name="android.permission.EXPAND_STATUS_BAR" />

    <!-- 网络权限 (Network Permissions) -->
    <!-- 访问网络状态 -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 访问互联网 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 访问WiFi状态 -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- 修改WiFi多播状态 -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!-- 媒体权限 (Media Permissions) -->
    <!-- 相机权限 -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- 录音权限 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- 读取媒体图片 -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <!-- 读取媒体视频 -->
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <!-- 读取媒体音频 -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />

    <!-- 存储权限 (Storage Permissions) -->
    <!-- 管理外部存储（Android 11+） -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <!-- 写入外部存储（Android 10及以下，可选） -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:required="false" />
    <!-- 读取外部存储（Android 10及以下，可选） -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:required="false" />

    <!-- ============================================ -->
    <!-- 硬件特性声明 (Hardware Features) -->
    <!-- ============================================ -->

    <!-- 触摸屏（可选，支持非触摸设备） -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <!-- Leanback模式（必需，用于Android TV） -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="true" />
    <!-- 相机硬件（可选） -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <!-- ============================================ -->
    <!-- 应用配置 (Application Configuration) -->
    <!-- ============================================ -->

    <application
        android:name=".ApplicationModelShared"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:networkSecurityConfig="@xml/network_sec_conf"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:screenOrientation="landscape"
        android:supportsRtl="true"
        android:theme="@style/Theme.IMatesApp.FullScreen"
        android:usesCleartextTraffic="true"
        tools:targetApi="31">

        <!-- Google Actions元数据 -->
        <meta-data
            android:name="com.google.android.actions"
            android:resource="@xml/shared_file_paths" />

        <!-- ============================================ -->
        <!-- Activity声明 (Activities) -->
        <!-- ============================================ -->

        <!-- 主WebView Activity -->
        <!-- 用于渲染整个imates-web项目，作为应用的主入口和启动器 -->
        <activity
            android:name=".ui.webview.MainWebViewActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation"
            android:exported="true"
            android:resizeableActivity="false"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.IMatesApp.FullScreen"
            android:windowSoftInputMode="adjustResize">
            <intent-filter android:priority="1000">
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.MONKEY" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ============================================ -->
        <!-- Service声明 (Services) -->
        <!-- ============================================ -->

        <!-- 悬浮按钮服务 -->
        <!-- 提供悬浮按钮功能的前台服务 -->
        <service
            android:name=".ui.fab.FloatingFabService"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse" />

        <!-- 应用监控服务 -->
        <!-- 监控其他应用的使用情况，用于Kiosk模式 -->
        <service
            android:name=".deviceadmin.AppMonitorService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse" />

        <!-- ============================================ -->
        <!-- Broadcast Receiver声明 (Receivers) -->
        <!-- ============================================ -->

        <!-- Kiosk设备管理员接收器 -->
        <!-- 处理设备管理员启用/禁用事件 -->
        <receiver
            android:name=".deviceadmin.KioskDeviceAdminReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin_policies" />

            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
                <action android:name="android.app.action.DEVICE_ADMIN_DISABLED" />
            </intent-filter>
        </receiver>

        <!-- 开机自启动接收器 -->
        <!-- 监听系统启动和应用更新事件，实现开机自启动 -->
        <receiver
            android:name=".deviceadmin.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter android:priority="1000">
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.PACKAGE_REPLACED" />

                <data android:scheme="package" />
            </intent-filter>
        </receiver>

        <!-- ============================================ -->
        <!-- Content Provider声明 (Providers) -->
        <!-- ============================================ -->

        <!-- 文件提供者 -->
        <!-- 用于应用间文件共享 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/shared_file_paths" />
        </provider>

    </application>

</manifest>
