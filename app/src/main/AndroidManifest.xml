<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:required="false" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:required="false" />

    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <uses-feature
        android:name="android.software.leanback"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"
        android:required="true" />

    <application
        android:name=".ApplicationModelShared"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_sec_conf"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:screenOrientation="landscape"
        android:supportsRtl="true"
        android:theme="@style/Theme.IMatesApp.FullScreen"
        tools:targetApi="31">
        <activity
            android:name=".activities.LoginActivity"
            android:exported="true"
            android:theme="@style/Theme.IMatesApp.FullScreen">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.MONKEY" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".activities.MainActivity"
            android:exported="true"
            android:resizeableActivity="true"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.IMatesApp.FullScreen"
            android:windowSoftInputMode="adjustPan"
            tools:ignore="DiscouragedApi" />

        <activity android:name="com.artifex.mupdfdemo.ChoosePDFActivity"
            android:theme="@style/Theme.IMatesApp.FullScreen"/>

        <activity android:name="com.artifex.mupdfdemo.MuPDFActivity"
            android:theme="@style/Theme.IMatesApp.FullScreen"/>

        <activity android:name="com.artifex.mupdfdemo.OutlineActivity"
            android:theme="@style/Theme.IMatesApp.FullScreen"/>

        <activity android:name="com.artifex.mupdfdemo.PrintDialogActivity"
            android:theme="@style/Theme.IMatesApp.FullScreen"/>

        <activity android:name=".pdfui.PDFPreviewActivity"
            android:theme="@style/Theme.IMatesApp.FullScreen"/>
        <activity android:name=".pdfui.PDFCatelogueActivity"
            android:theme="@style/Theme.IMatesApp.FullScreen"/>
        <activity android:name=".pdfui.PDFActivity"
            android:theme="@style/Theme.IMatesApp.FullScreen"/>

        <service
            android:name=".service.FloatingWindowService"
            android:enabled="true"
            android:exported="false"/>
    </application>

</manifest>