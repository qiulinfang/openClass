<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:required="false" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:required="false" />

    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <uses-feature
        android:name="android.software.leanback"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <uses-permission
        android:name="android.permission.SYSTEM_ALERT_WINDOW"
        android:required="true" />

    <application
        android:name=".ApplicationModelShared"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_sec_conf"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:screenOrientation="landscape"
        android:supportsRtl="true"
        android:theme="@style/Theme.IMatesApp.FullScreen"
        tools:targetApi="31">
        <activity
            android:name=".FeedbackActivity"
            android:configChanges="orientation|keyboardHidden|screenSize"
            android:exported="false"
            android:theme="@style/Theme.IMatesApp.FullScreen.Fullscreen" />
        <activity
            android:name=".activities.PhotoQuestionLookupActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation"
            android:exported="false"
            android:screenOrientation="landscape" />
        <activity
            android:name=".activities.QuestionSolveActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation"
            android:exported="false"
            android:screenOrientation="landscape" />
        <activity
            android:name=".activities.FloatChatAiActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation"
            android:exported="false"
            android:screenOrientation="landscape" />
        <activity
            android:name=".activities.LessonPreviewActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation"
            android:exported="false"
            android:screenOrientation="landscape" />
        <activity
            android:name=".activities.VideoPlayActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation"
            android:exported="false"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:supportsPictureInPicture="true"
            android:theme="@style/Theme.IMatesApp.FullScreen" />
        <activity
            android:name=".activities.LoginActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation"
            android:exported="true"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.IMatesApp.FullScreen">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.MONKEY" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".activities.MainActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation"
            android:exported="true"
            android:resizeableActivity="true"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.IMatesApp.FullScreen"
            android:windowSoftInputMode="adjustPan"
            tools:ignore="DiscouragedApi" />
        <activity
            android:name=".activities.ScreenShotActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <activity
            android:name=".activities.ChatAiActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.IMatesApp.FullScreen" />

        <activity
            android:name=".mupdfviewer.activity.MuPDFActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.IMatesApp.FullScreen" />
        <activity
            android:name=".mupdfviewer.activity.OutlineActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.IMatesApp.FullScreen" />
        <activity
            android:name=".mupdfviewer.activity.AllPDFActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.IMatesApp.FullScreen" />
        <activity
            android:name=".mupdfviewer.activity.BasePDFActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.IMatesApp.FullScreen" />
        <activity
            android:name=".mupdfviewer.activity.MoreSetActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.IMatesApp.FullScreen" />
        <activity
            android:name=".mupdfviewer.activity.SignActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.IMatesApp.FullScreen" /> <!-- <activity android:name="com.artifex.mupdfdemo.ChoosePDFActivity" -->
        <!-- android:theme="@style/Theme.IMatesApp.FullScreen"/> -->
        <!-- <activity android:name="com.artifex.mupdfdemo.PrintDialogActivity" -->
        <!-- android:theme="@style/Theme.IMatesApp.FullScreen"/> -->
        <activity
            android:name=".pdfui.PDFPreviewActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.IMatesApp.FullScreen" />
        <activity
            android:name=".pdfui.PDFCatelogueActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.IMatesApp.FullScreen" />
        <activity
            android:name=".pdfui.PDFActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.IMatesApp.FullScreen" />

        <service
            android:name=".service.FloatingRobotService"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="dataSync|mediaProjection" />
    </application>

</manifest>