<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#F7EAEAEA"
    android:padding="8dp">

    <CheckBox
        android:id="@+id/btn_view_history"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:gravity="center_vertical"
        android:text="历史记录"
        android:layout_alignParentEnd="true"/>

    <TextView
        android:id="@+id/ai_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentStart="true"
        android:textAlignment="center"
        android:text="@string/chatbot_name"
        android:textSize="12sp"
        android:textColor="@color/black"
        />

    <!-- 下边框 -->
    <View
        android:id="@+id/split_line"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/gray3"
        android:layout_alignParentStart="true"
        android:layout_below="@id/btn_view_history" />

    <LinearLayout
        android:id="@+id/history_layout"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:layout_margin="8dp"
        android:background="#ffffff"
        android:minWidth="80dp"
        android:visibility="gone"
        android:layout_alignParentStart="true"
        android:layout_alignTop="@id/split_line">

        <com.cosinetech.imates.widgets.FlowTagLayout
            android:id="@+id/chat_tags"
            android:background="#8090e0"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:minHeight="80dp"/>

        <ListView
            android:id="@+id/chat_catalog"
            android:layout_width="150dp"
            android:layout_height="match_parent" />
    </LinearLayout>

    <com.scwang.smart.refresh.layout.SmartRefreshLayout
        android:id="@+id/chat_message_session"
        android:layout_below="@id/split_line"
        android:layout_above="@id/chat_input_area"
        android:layout_alignParentEnd="true"
        android:layout_toEndOf="@id/history_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.scwang.smart.refresh.header.ClassicsHeader
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/chat_msg_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="8dp"
            android:clipToPadding="false" />
    </com.scwang.smart.refresh.layout.SmartRefreshLayout>

    <!-- 聊天输入区域 -->
    <RelativeLayout
        android:id="@+id/chat_input_area"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="40dp"
        android:background="#80FFFFFF"
        android:layout_toEndOf="@id/history_layout"
        android:layout_alignParentBottom="true">

        <!-- 左侧的键盘按钮 -->
        <Button
            android:id="@+id/btn_kbd"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/ic_keyboard"
            android:stateListAnimator="@animator/button_click_scale"
            android:scaleType="center"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:visibility="invisible"/>

        <!-- 左侧的语音按钮 -->
        <Button
            android:id="@+id/btn_voice"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/ic_mic"
            android:stateListAnimator="@animator/button_click_scale"
            android:layout_marginHorizontal="@dimen/min_margin_size"
            android:scaleType="center"
            android:visibility="invisible"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true" />

        <!-- 中间的输入框 -->
        <EditText
            android:id="@+id/et_message"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/btn_voice"
            android:layout_toStartOf="@id/btn_more"
            android:layout_marginHorizontal="@dimen/min_margin_size"
            android:autofillHints=" "
            android:background="@drawable/chat_ai_edit_background"
            android:padding="2dp"
            android:textSize="12sp"
            android:gravity="center_vertical"
            android:inputType="textMultiLine"
            android:layout_centerVertical="true"
            android:minHeight="12sp"/>

        <Button
            android:id="@+id/voice_message"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/btn_voice"
            android:layout_toStartOf="@id/btn_more"
            android:layout_marginHorizontal="@dimen/min_margin_size"
            android:autofillHints=" "
            android:background="@drawable/chat_ai_edit_background"
            android:stateListAnimator="@animator/button_click_scale"
            android:padding="10dp"
            android:text="按住 说话"
            android:textAlignment="center"
            android:layout_centerVertical="true"
            android:maxLines="4"
            android:minHeight="20dp"
            android:visibility="invisible"/>

        <!-- 扩展功能按钮 -->
        <Button
            android:id="@+id/btn_more"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginHorizontal="@dimen/min_margin_size"
            android:src="@mipmap/ic_cheat_add"
            android:scaleType="center"
            android:layout_toStartOf="@id/btn_send"
            android:stateListAnimator="@animator/button_click_scale"
            android:layout_centerVertical="true"
            android:visibility="gone"/>

        <!-- 发送按钮 -->
        <Button
            android:id="@+id/btn_send"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginHorizontal="@dimen/min_margin_size"
            android:background="@drawable/ic_send"
            android:stateListAnimator="@animator/button_click_scale"
            android:scaleType="center"
            android:textColor="@color/white"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true" />
    </RelativeLayout>

    <!-- 全屏灰色背景 + 录音动画 -->
    <FrameLayout
        android:id="@+id/voice_record_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000"
        android:visibility="gone">

        <!-- 动画区域 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_gravity="center">

            <ImageView
                android:id="@+id/iv_mic_animation"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:src="@drawable/ic_voice"
                android:layout_gravity="center" />

            <TextView
                android:id="@+id/tv_recording_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="松开结束录音"
                android:textColor="@android:color/white"
                android:textSize="16sp" />
        </LinearLayout>
    </FrameLayout>

</RelativeLayout>
