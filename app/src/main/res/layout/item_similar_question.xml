<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/item_exercise_background"
    android:clickable="true"
    android:focusable="true">

    <TextView
        android:id="@+id/item_number"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="18sp"
        android:minHeight="24dp"
        android:textColor="@android:color/black"
        android:layout_gravity="start"
        android:layout_marginEnd="8dp" />

    <com.cosinetech.imates.views.MarkdownTextView
        android:id="@+id/question_text"
        android:clickable="true"
        android:focusable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#000000"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/add_to_list"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:textColor="#ffffff"
            android:background="@drawable/knowledge_similar_button_bk"
            android:text = "加入习题列表"/>

        <Button
            android:id="@+id/add_to_favor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:visibility="gone"
            android:textColor="#ffffff"
            android:background="@drawable/button_bk"
            android:text = "加入我的收藏"/>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#000000"
        android:layout_marginTop="16dp"/>
</LinearLayout>