<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout android:id="@+id/layout_chat"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/chat_ai_dialog_bg"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <TextView
        android:id="@+id/ai_name"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentStart="true"
        android:layout_alignParentEnd="true"
        android:textAlignment="center"
        android:gravity="center"
        android:text="@string/chatbot_name"
        android:textColor="#ffffff"
        />

    <CheckBox
        android:id="@+id/btn_view_history"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="6dp"
        android:minHeight="60dp"
        android:textColor="#ffffff"
        android:button="@null"
        android:background="@drawable/chat_ai_history_button_bg"
        android:stateListAnimator="@animator/app_button_click_scale"
        android:layout_alignParentTop="true"
        android:layout_toStartOf="@id/et_search"/>

    <CheckBox
        android:id="@+id/btn_set_ai_param"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="8dp"
        android:minHeight="60dp"
        android:textColor="#ffffff"
        android:button="@null"
        android:visibility="visible"
        android:background="@drawable/chat_ai_settings"
        android:stateListAnimator="@animator/app_button_click_scale"
        android:layout_alignParentTop="true"
        android:layout_toStartOf="@id/btn_view_history"/>

    <Button
        android:id="@+id/btn_add_favor"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/chat_ai_add_favor"
        android:stateListAnimator="@animator/app_button_click_scale"
        android:layout_toStartOf="@id/btn_set_ai_param"/>

    <Button
        android:id="@+id/btn_new_chat"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/chat_ai_new_chat"
        android:stateListAnimator="@animator/app_button_click_scale"
        android:layout_toStartOf="@id/btn_add_favor"/>

    <EditText
        android:id="@+id/et_search"
        android:layout_width="200dp"
        android:layout_height="30dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="9dp"
        android:textAlignment="center"
        android:gravity="center"
        android:autofillHints=""
        android:visibility="gone"
        android:hint="搜索聊天记录"
        android:imeOptions="actionSearch"
        android:inputType="text"
        android:singleLine="true"
        android:background="@drawable/chat_ai_text_input_bg"
        android:textSize="12sp"
        android:paddingHorizontal="10dp"
        android:layout_toStartOf="@id/btn_search"/>

    <CheckBox
        android:id="@+id/btn_search"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_marginTop="3dp"
        android:layout_marginEnd="16dp"
        android:button="@null"
        android:background="@drawable/chat_ai_history_search_bg"
        android:stateListAnimator="@animator/app_button_click_scale"
        android:layout_alignParentEnd="true"/>

    <LinearLayout
        android:id="@+id/select_chat_msg_area"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:orientation="horizontal"
        android:layout_alignParentTop="true"
        android:layout_marginStart="48dp"
        android:layout_marginTop="6dp"
        android:minHeight="60dp"
        android:layout_alignParentStart="true">

        <CheckBox
            android:id="@+id/chk_select_history"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginEnd="16dp"
            android:textColor="#ffffff"
            android:button="@null"
            android:layout_gravity="center_vertical"
            android:background="@drawable/chat_ai_select_item"
            android:stateListAnimator="@animator/app_button_click_scale" />
    </LinearLayout>

    <!-- 下边框 -->
    <View
        android:id="@+id/split_line"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/gray3"
        android:layout_alignParentStart="true"
        android:layout_below="@id/ai_name" />

    <FrameLayout
        android:id="@+id/history_layout"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_below="@id/split_line"
        android:orientation="vertical"
        android:visibility="gone"
        android:background="@drawable/chat_ai_history_area_bg">

        <ExpandableListView
            android:id="@+id/expandable_list_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@android:color/darker_gray"
            android:dividerHeight="0.5dp"
            android:groupIndicator="@null"
            android:clickable="true"/>
    </FrameLayout>

    <View
        android:id="@+id/v_split"
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:layout_toEndOf="@id/history_layout"
        android:layout_below="@id/split_line"
        android:layout_alignParentBottom="true"
        android:background="#000000"/>

    <com.scwang.smart.refresh.layout.SmartRefreshLayout
        android:id="@+id/chat_msg_refresh_layout"
        android:layout_below="@id/split_line"
        android:layout_above="@id/chat_input_area"
        android:layout_alignParentEnd="true"
        android:layout_toEndOf="@id/v_split"
        android:background="@drawable/chat_ai_msg_list_bg"
        android:layout_width="match_parent"
        android:layout_height="0dp">

        <com.scwang.smart.refresh.header.ClassicsHeader
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/chat_msg_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="8dp"
            android:clipToPadding="false" />
    </com.scwang.smart.refresh.layout.SmartRefreshLayout>

    <!-- 聊天输入区域 -->
    <RelativeLayout
        android:id="@+id/chat_input_area"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_toEndOf="@id/v_split"
        android:background="#ffffffff"
        android:layout_alignParentBottom="true">

        <!-- 左侧的键盘按钮 -->
        <Button
            android:id="@+id/input_keyboard"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/ic_keyboard"
            android:stateListAnimator="@animator/app_button_click_scale"
            android:layout_marginHorizontal="@dimen/min_margin_size"
            android:scaleType="center"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:visibility="gone"/>

        <!-- 左侧的语音按钮 -->
        <Button
            android:id="@+id/btn_voice"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/chat_ai_button_voice_bk"
            android:stateListAnimator="@animator/app_button_click_scale"
            android:layout_marginHorizontal="@dimen/min_margin_size"
            android:scaleType="center"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true" />

        <!-- 中间的输入框 -->
        <EditText
            android:id="@+id/et_message"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_toStartOf="@id/check_search_web"
            android:layout_toEndOf="@id/btn_voice"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginVertical="8dp"
            android:autofillHints=""
            android:hint="@string/chat_ai_input_hint"
            android:background="@drawable/chat_ai_text_input_bg"
            android:textSize="14sp"
            android:paddingHorizontal="10dp"
            android:gravity="center_vertical"
            android:inputType="textMultiLine"
            android:layout_centerVertical="true"/>

<!--        语音输入-->
        <Button
            android:id="@+id/voice_message"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_toEndOf="@id/input_keyboard"
            android:layout_alignParentEnd="true"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginVertical="8dp"
            android:autofillHints=" "
            android:background="@drawable/chat_ai_edit_background"
            android:stateListAnimator="@animator/app_button_click_scale"
            android:padding="10dp"
            android:text="@string/chat_ai_voice_hint"
            android:textColor="#000000"
            android:textAlignment="center"
            android:layout_centerVertical="true"
            android:maxLines="4"
            android:minHeight="40dp"
            android:visibility="gone"/>

<!--        <Button-->
<!--            android:layout_width="0dp"-->
<!--            android:layout_height="wrap_content"-->
<!--            android:layout_toEndOf="@id/btn_voice"-->
<!--            android:layout_toStartOf="@id/btn_send_picture"-->
<!--            android:layout_marginHorizontal="@dimen/min_margin_size"-->
<!--            android:autofillHints=" "-->
<!--            android:background="@drawable/chat_ai_edit_background"-->
<!--            android:stateListAnimator="@animator/app_button_click_scale"-->
<!--            android:text="@string/chat_ai_press_to_speak"-->
<!--            android:textAlignment="center"-->
<!--            android:layout_centerVertical="true"-->
<!--            android:maxLines="4"-->
<!--            android:minHeight="2dp"-->
<!--            android:visibility="gone"/>-->

        <!--是否联网搜索-->
        <CheckBox
            android:id="@+id/check_search_web"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="6dp"
            android:minHeight="60dp"
            android:button="@null"
            android:text="联网"
            android:textSize="10sp"
            android:textAlignment="center"
            android:textColor="#ffffff"
            android:background="@drawable/chat_ai_search_web_bg"
            android:stateListAnimator="@animator/app_button_click_scale"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@id/btn_send_picture"/>

        <!-- 发送图片功能按钮 -->
        <Button
            android:id="@+id/btn_send_picture"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/chat_ai_send_picture_bg"
            android:layout_toStartOf="@id/btn_send"
            android:stateListAnimator="@animator/app_button_click_scale"
            android:layout_centerVertical="true"/>

        <!-- 发送按钮 -->
        <Button
            android:id="@+id/btn_send"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/chat_ai_button_send_bk"
            android:stateListAnimator="@animator/app_button_click_scale"
            android:scaleType="center"
            android:textColor="@color/white"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true" />
    </RelativeLayout>

    <LinearLayout
        android:id="@+id/select_history_function"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_toEndOf="@id/v_split"
        android:background="#ffffffff"
        android:orientation="vertical"
        android:layout_alignParentBottom="true"
        android:visibility="gone">
        <Button
            android:id="@+id/btn_ask_teacher"
            android:layout_width="96dp"
            android:layout_height="match_parent"
            android:layout_marginStart="16dp"
            android:textColor="#000000"
            android:text="@string/chat_ai_forward_to_teacher"
            android:background="#ffffff"
            android:layout_gravity="center_vertical"
            android:drawableTop="@drawable/chat_ai_ask_teacher"
            android:stateListAnimator="@animator/app_button_click_scale" />
    </LinearLayout>

    <!-- 全屏灰色背景 + 录音动画 -->
    <!-- 动画区域 -->
    <RelativeLayout
        android:id="@+id/voice_animate_area"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_gravity="center"
        android:background="#80000000"
        android:focusable="true"
        android:visibility="gone">

        <com.airbnb.lottie.LottieAnimationView
            android:layout_width="200dp"
            android:layout_height="100dp"
            android:layout_centerInParent="true"
            app:lottie_fileName="AnimationAudioPlaying.lottie"
            app:lottie_autoPlay="true"
            app:lottie_loop="true"
            android:layout_gravity="center"
            android:padding="0dp"
            android:scaleType="centerCrop"/>

        <!-- 转文字区域 -->
        <TextView
            android:id="@+id/tip_cancel"
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:layout_above="@id/cancel_record"
            android:layout_marginHorizontal="16dp"
            android:gravity="center"
            android:text="松开取消"
            android:textSize="16sp"
            android:textColor="#ffffff"/>

        <!-- 取消录音区域 -->
        <ImageView
            android:id="@+id/cancel_record"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_marginBottom="16dp"
            android:layout_marginStart="16dp"
            android:layout_above="@id/tip_send"
            android:contentDescription=""
            android:text="@string/chat_ai_release_to_cancel"
            android:src="@drawable/chat_ai_cancel_send"
            android:textSize="16sp"/>

        <!-- 转文字区域 -->
        <TextView
            android:id="@+id/convert_text"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_gravity="bottom"
            android:gravity="center"
            android:text="→ 松开转文字"
            android:textSize="16sp"
            android:textColor="@android:color/holo_blue_light"
            android:visibility="invisible"/>

        <TextView
            android:id="@+id/tip_send"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_above="@id/voice_bg"
            android:layout_centerHorizontal="true"
            android:text="@string/chat_ai_release_to_end_speak"
            android:textColor="@android:color/white"
            android:textSize="16sp" />

        <ImageView
            android:id="@+id/voice_bg"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_alignParentBottom="true"
            android:scaleType="fitXY"
            android:src="@drawable/chat_ai_silver_bg"/>

    </RelativeLayout>

</RelativeLayout>
