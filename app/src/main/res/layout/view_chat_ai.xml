<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout android:id="@+id/layout_chat"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/chat_ai_dialog_bg">

    <CheckBox
        android:id="@+id/btn_view_history"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="6dp"
        android:minHeight="60dp"
        android:textColor="#ffffff"
        android:button="@null"
        android:background="@drawable/chat_ai_history_button_bg"
        android:layout_alignParentTop="true"
        android:layout_toStartOf="@id/et_search"/>

    <CheckBox
        android:id="@+id/btn_view_category"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="10dp"
        android:minHeight="60dp"
        android:textColor="#ffffff"
        android:button="@null"
        android:background="@drawable/chat_ai_history_category_bg"
        android:layout_alignParentTop="true"
        android:layout_toStartOf="@id/btn_view_history"/>

    <Button
        android:id="@+id/btn_add_favor"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/chat_ai_add_favor"
        android:layout_toStartOf="@id/btn_view_category"/>

    <Button
        android:id="@+id/btn_new_chat"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/chat_ai_new_chat"
        android:layout_toStartOf="@id/btn_add_favor"/>

    <EditText
        android:id="@+id/et_search"
        android:layout_width="200dp"
        android:layout_height="30dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="9dp"
        android:textAlignment="center"
        android:gravity="center"
        android:autofillHints=""
        android:visibility="gone"
        android:hint="搜索聊天记录"
        android:imeOptions="actionSearch"
        android:inputType="text"
        android:singleLine="true"
        android:background="@drawable/chat_ai_text_input_bg"
        android:textSize="12sp"
        android:paddingHorizontal="10dp"
        android:layout_toStartOf="@id/btn_search"/>

    <CheckBox
        android:id="@+id/btn_search"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_marginTop="3dp"
        android:layout_marginEnd="16dp"
        android:button="@null"
        android:background="@drawable/chat_ai_history_search_bg"
        android:layout_alignParentEnd="true"/>


    <TextView
        android:id="@+id/ai_name"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentStart="true"
        android:layout_toStartOf="@id/btn_view_category"
        android:textAlignment="center"
        android:gravity="center"
        android:text="@string/chatbot_name"
        android:textColor="#ffffff"
        />

    <!-- 下边框 -->
    <View
        android:id="@+id/split_line"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/gray3"
        android:layout_alignParentStart="true"
        android:layout_below="@id/ai_name" />

    <LinearLayout
        android:id="@+id/history_layout"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@drawable/chat_ai_history_area_bg"
        android:minWidth="100dp"
        android:visibility="visible"
        android:layout_alignParentStart="true"
        android:layout_below="@id/split_line"
        android:layout_alignParentBottom="true">

        <com.cosinetech.imates.views.FlowTagLayout
            android:id="@+id/chat_category"
            android:background="#8090e0"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>

        <ListView
            android:id="@+id/chat_session_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </LinearLayout>

    <View
        android:id="@+id/v_split"
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:layout_toEndOf="@id/history_layout"
        android:layout_below="@id/split_line"
        android:layout_alignParentBottom="true"
        android:background="#000000"/>

    <com.scwang.smart.refresh.layout.SmartRefreshLayout
        android:id="@+id/chat_message_list"
        android:layout_below="@id/split_line"
        android:layout_above="@id/chat_input_area"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"
        android:layout_toEndOf="@id/v_split"
        android:background="@drawable/chat_ai_msg_list_bg"
        android:layout_width="match_parent"
        android:layout_height="0dp">

        <com.scwang.smart.refresh.header.ClassicsHeader
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/chat_msg_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="8dp"
            android:clipToPadding="false" />
    </com.scwang.smart.refresh.layout.SmartRefreshLayout>

    <!-- 聊天输入区域 -->
    <RelativeLayout
        android:id="@+id/chat_input_area"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_toEndOf="@id/v_split"
        android:background="#ffffffff"
        android:layout_alignParentBottom="true">

        <!-- 左侧的键盘按钮 -->
        <Button
            android:id="@+id/input_keyboard"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/ic_keyboard"
            android:stateListAnimator="@animator/app_button_click_scale"
            android:scaleType="center"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:visibility="gone"/>

        <!-- 左侧的语音按钮 -->
        <Button
            android:id="@+id/btn_voice"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/ic_mic"
            android:stateListAnimator="@animator/app_button_click_scale"
            android:layout_marginHorizontal="@dimen/min_margin_size"
            android:scaleType="center"
            android:visibility="gone"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true" />

        <!-- 中间的输入框 -->
        <EditText
            android:id="@+id/et_message"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_alignParentStart="true"
            android:layout_toStartOf="@id/btn_send"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginVertical="10dp"
            android:autofillHints=""
            android:hint="请输入内容"
            android:background="@drawable/chat_ai_text_input_bg"
            android:textSize="12sp"
            android:paddingHorizontal="10dp"
            android:gravity="center_vertical"
            android:inputType="textMultiLine"
            android:layout_centerVertical="true"/>

        <Button
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/btn_voice"
            android:layout_toStartOf="@id/btn_more"
            android:layout_marginHorizontal="@dimen/min_margin_size"
            android:autofillHints=" "
            android:background="@drawable/chat_ai_edit_background"
            android:stateListAnimator="@animator/app_button_click_scale"
            android:text="按住 说话"
            android:textAlignment="center"
            android:layout_centerVertical="true"
            android:maxLines="4"
            android:minHeight="2dp"
            android:visibility="gone"/>

        <!-- 扩展功能按钮 -->
        <Button
            android:id="@+id/btn_more"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginHorizontal="@dimen/min_margin_size"
            android:src="@mipmap/ic_cheat_add"
            android:scaleType="center"
            android:layout_toStartOf="@id/btn_send"
            android:stateListAnimator="@animator/app_button_click_scale"
            android:layout_centerVertical="true"
            android:visibility="gone"/>

        <!-- 发送按钮 -->
        <Button
            android:id="@+id/btn_send"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/chat_ai_button_send_bk"
            android:stateListAnimator="@animator/app_button_click_scale"
            android:scaleType="center"
            android:textColor="@color/white"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true" />
    </RelativeLayout>

    <!-- 全屏灰色背景 + 录音动画 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000"
        android:visibility="gone">

        <!-- 动画区域 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_gravity="center">

            <ImageView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:src="@drawable/ic_voice"
                android:layout_gravity="center" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="松开结束录音"
                android:textColor="@android:color/white"
                android:textSize="16sp" />
        </LinearLayout>
    </FrameLayout>

</RelativeLayout>
