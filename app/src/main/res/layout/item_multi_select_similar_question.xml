<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="16dp"
    android:background="@drawable/item_exercise_background"
    android:clickable="true"
    android:focusable="true">

    <TextView
        android:id="@+id/item_number"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="2dp"
        android:textSize="18sp"
        android:textColor="@android:color/black"
        android:layout_gravity="start"
        android:layout_marginEnd="8dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"/>

    <com.cosinetech.imates.views.MarkdownTextView
        android:id="@+id/question_text"
        android:clickable="true"
        android:focusable="false"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:textColor="#000000"
        android:lineSpacingMultiplier="1.5"
        android:layout_alignParentStart="true"
        android:layout_toStartOf="@id/add_to_list"
        android:layout_below="@id/item_number"/>

    <CheckBox
        android:id="@+id/add_to_list"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_margin="8dp"
        android:textColor="#ffffff"
        android:button="@null"
        android:background="@drawable/app_checkbox_bk"
        android:layout_centerVertical="true"
        android:layout_alignParentEnd="true"/>

    <Button
        android:id="@+id/add_to_favor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:visibility="gone"
        android:textColor="#ffffff"
        android:background="@drawable/button_bk"
        android:text = "加入我的收藏"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#000000"
        android:layout_alignParentBottom="true"/>

</RelativeLayout>