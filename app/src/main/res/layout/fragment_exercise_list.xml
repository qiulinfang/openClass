<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#80FFFFFF"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".FragmentSubjectBiology">

    <TextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/exerciseList"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginVertical="16dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintTop_toTopOf="@id/title"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="@id/verticalGuide"/>

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/verticalGuide"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.6" />

    <FrameLayout
        android:id="@+id/fragmentChatAiContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="16dp"
        android:layout_marginTop="1dp"
        app:layout_constraintTop_toBottomOf="@id/spliter"
        app:layout_constraintStart_toStartOf="@id/verticalGuide"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <RadioButton
        android:id="@+id/btnChatAi"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="解析分析"
        android:button="@null"
        android:background="@drawable/button_background"
        android:textColor="@drawable/button_text_color"
        app:layout_constraintTop_toBottomOf="@id/title"
        app:layout_constraintStart_toStartOf="@id/fragmentChatAiContainer"/>

    <Button
        android:id="@+id/btnAnswer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="查看答案"
        android:enabled="false"
        android:background="@drawable/button_background"
        android:textColor="@drawable/button_text_color"
        android:layout_marginHorizontal="4dp"
        app:layout_constraintTop_toBottomOf="@id/title"
        app:layout_constraintStart_toEndOf="@id/btnChatAi" />

    <Button
        android:id="@+id/btnSimilar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="举一反三"
        android:enabled="false"
        android:background="@drawable/button_background"
        android:textColor="@drawable/button_text_color"
        android:layout_marginHorizontal="4dp"
        app:layout_constraintTop_toBottomOf="@id/title"
        app:layout_constraintStart_toEndOf="@id/btnAnswer" />

    <Button
        android:id="@+id/btnCapture"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="拍照识题"
        android:background="@drawable/button_background"
        android:textColor="@drawable/button_text_color"
        android:layout_marginHorizontal="4dp"
        app:layout_constraintTop_toBottomOf="@id/title"
        app:layout_constraintStart_toEndOf="@id/btnSimilar" />

    <View
        android:id="@+id/spliter"
        android:layout_width="0dp"
        android:layout_height="2dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintTop_toBottomOf="@id/btnChatAi"
        app:layout_constraintStart_toStartOf="@id/verticalGuide"
        app:layout_constraintEnd_toEndOf="parent"
        android:background="#80808080"/>



</androidx.constraintlayout.widget.ConstraintLayout>