<?xml version="1.0" encoding="utf-8"?>
 <androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
     xmlns:app="http://schemas.android.com/apk/res-auto"
     android:layout_width="match_parent"
     android:layout_height="match_parent"
     android:background="#80FFFFFF"
     xmlns:tools="http://schemas.android.com/tools"
     tools:context=".FragmentSubjectBiology">

    <LinearLayout
        android:id="@+id/todo"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/guideline"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_margin="16dp"
        android:orientation="vertical"
        android:background="@drawable/todo_list_bg">

        <!-- Header -->
        <LinearLayout
            android:id="@+id/headerLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/todo_list_bg"
            android:padding="16dp"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/btnList"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/todo_list_title"
                android:textColor="@android:color/black"
                android:textSize="18sp"/>

            <Space
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>

            <Button
                android:id="@+id/btnAddTask"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/todo_add_item"
                android:textColor="@android:color/white"
                android:background="@drawable/todo_list_button_bg"/>
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/taskList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginEnd="16dp" />

    </LinearLayout>

    <GridLayout
            android:id="@+id/menuLayout"
            android:columnCount="2"
            android:rowCount="2"
            android:padding="8dp"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            app:layout_constraintStart_toEndOf="@+id/guideline"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <androidx.cardview.widget.CardView
                android:id="@+id/photo_to_solve"
                android:backgroundTint="@android:color/holo_purple"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackgroundBorderless"
                style="@style/MenuCard">
                <TextView
                    style="@style/MenuText"
                    android:textColor="@color/black"
                    android:text="@string/take_photo_solve_question"/>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/menuHomework"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackgroundBorderless"
                style="@style/MenuCard"
                android:backgroundTint="@android:color/holo_blue_light">
                <TextView
                    style="@style/MenuText"
                    android:textColor="@color/black"
                    android:text="@string/my_favorite"/>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/menuMaterials"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackgroundBorderless"
                style="@style/MenuCard"
                android:textColor="@color/black"
                android:backgroundTint="@android:color/holo_green_light">
                <TextView
                    style="@style/MenuText"
                    android:textColor="@color/black"
                    android:text="@string/question_list"/>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/menuWrongQuestions"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackgroundBorderless"
                style="@style/MenuCard"
                android:backgroundTint="@android:color/holo_orange_light">
                <TextView
                    style="@style/MenuText"
                    android:textColor="@color/black"
                    android:text="@string/history_archive"/>
            </androidx.cardview.widget.CardView>

        </GridLayout>

    <!-- Guideline -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.6" />

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/camera_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>