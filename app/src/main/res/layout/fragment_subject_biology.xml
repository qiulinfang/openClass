<?xml version="1.0" encoding="utf-8"?>
 <androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
     xmlns:app="http://schemas.android.com/apk/res-auto"
     android:layout_width="match_parent"
     android:layout_height="match_parent"
     android:background="#80FFFFFF"
     xmlns:tools="http://schemas.android.com/tools"
     tools:context=".fragments.FragmentSubjectBiology">
    <LinearLayout
        android:id="@+id/tool_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#71c9f6"
        android:minHeight="80dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#000000"
            android:textStyle="bold"
            android:layout_marginStart="10dp"
            android:textSize="@dimen/reflow_text_title_size"
            android:text="待办事项"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:textColor="#000000"
            android:layout_marginStart="12dp"
            android:text="①复习5.1学过的内容"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:textColor="#000000"
            android:layout_marginStart="12dp"
            android:text="②预习5.2的内容"/>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/todo"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/guideline"
        app:layout_constraintTop_toBottomOf="@id/tool_bar"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_margin="16dp"
        android:orientation="vertical"
        android:background="@drawable/todo_list_bg">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#000000"
            android:textStyle="bold"
            android:textSize="@dimen/reflow_text_title_size"
            android:layout_marginStart="10dp"
            android:layout_marginTop="10dp"
            android:text="我的知识图谱"/>

        <WebView
            android:id="@+id/knowledge_view"
            android:background="@drawable/round_corner"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="24dp"
            android:focusable="true"
            android:focusableInTouchMode="true"/>

    </LinearLayout>

    <GridLayout
            android:id="@+id/menuLayout"
            android:columnCount="2"
            android:rowCount="2"
            android:padding="8dp"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintStart_toEndOf="@+id/guideline"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tool_bar"
            app:layout_constraintBottom_toBottomOf="parent">

            <androidx.cardview.widget.CardView
                android:id="@+id/photo_to_solve"
                android:backgroundTint="@android:color/holo_purple"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackgroundBorderless"
                style="@style/MenuCard">
                <TextView
                    style="@style/MenuText"
                    android:textColor="@color/black"
                    android:text="@string/take_photo_solve_question"/>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/card_my_favor"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackgroundBorderless"
                style="@style/MenuCard"
                android:backgroundTint="@android:color/holo_blue_light">
                <TextView
                    style="@style/MenuText"
                    android:textColor="@color/black"
                    android:text="@string/my_favorite"/>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/exercise"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackgroundBorderless"
                style="@style/MenuCard"
                android:textColor="@color/black"
                android:backgroundTint="@android:color/holo_green_light">
                <TextView
                    style="@style/MenuText"
                    android:textColor="@color/black"
                    android:text="@string/question_list"/>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/history"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackgroundBorderless"
                style="@style/MenuCard"
                android:backgroundTint="@android:color/holo_orange_light">
                <TextView
                    style="@style/MenuText"
                    android:textColor="@color/black"
                    android:text="@string/history_archive"/>
            </androidx.cardview.widget.CardView>

        </GridLayout>

    <!-- Guideline -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.6" />

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>