<?xml version="1.0" encoding="utf-8"?>
 <androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
     xmlns:app="http://schemas.android.com/apk/res-auto"
     android:layout_width="match_parent"
     android:layout_height="match_parent"
     android:background="@android:color/transparent"
     xmlns:tools="http://schemas.android.com/tools"
     android:paddingTop="40dp"
     android:paddingStart="30dp"
     tools:context=".fragments.FragmentSubjectBiology">
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/guideline"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_margin="16dp"
        android:orientation="vertical"
        android:background="@drawable/subject_biology_todo_list_bg">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="84dp"
            android:background="@drawable/subject_biology_todo_list_top_bg">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginStart="16dp"
                android:contentDescription=""
                android:src="@drawable/app_textbook"/>
            <Spinner
                android:id="@+id/spinner_textbook_versions"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginStart="16dp"
                android:spinnerMode="dialog"/>
            <Spinner
                android:id="@+id/spinner_textbook_volumes"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginStart="16dp"
                android:spinnerMode="dialog"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:textColor="#000000"
                android:textSize="22sp"
                android:layout_marginStart="32dp"
                android:layout_marginTop="20dp"
                android:visibility="gone"
                android:text="知识图谱"/>
            <ImageView
                android:layout_width="15dp"
                android:layout_height="8dp"
                android:visibility="gone"
                android:layout_marginLeft="13dp"
                android:layout_marginTop="38dp"
                android:src="@drawable/subject_biology_todo_list_arrow"/>
        </LinearLayout>
        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="#c0c0c0"/>
        <WebView
            android:id="@+id/knowledge_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="8dp"
            android:background="@drawable/round_corner"
            android:focusable="true"
            android:focusableInTouchMode="true"/>

    </LinearLayout>

    <LinearLayout
        android:paddingHorizontal="8dp"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="16dp"
        android:background="@android:color/transparent"
        android:orientation="vertical"
        app:layout_constraintStart_toEndOf="@+id/guideline"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.cardview.widget.CardView
            android:id="@+id/photo_to_solve"
            style="@style/MenuCard"
            android:background="@android:color/transparent"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:src="@drawable/subject_biology_photo_to_solve"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="拍照答疑"
                android:textColor="@color/white"
                android:textSize="32sp"
                android:paddingLeft="24dp"
                android:paddingTop="32dp"/>
        </androidx.cardview.widget.CardView>

        <!-- 占位空间 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <androidx.cardview.widget.CardView
            android:id="@+id/card_my_favor"
            style="@style/MenuCard"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:layout_marginStart="0dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:src="@drawable/subject_biology_card_my_favor"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="@string/my_favorite"
                android:textColor="@color/white"
                android:textSize="32sp"
                android:paddingLeft="24dp"
                android:paddingTop="32dp"/>
        </androidx.cardview.widget.CardView>

        <!-- 占位空间 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <androidx.cardview.widget.CardView
            android:id="@+id/exercise"
            android:clickable="true"
            android:focusable="true"
            style="@style/MenuCard"
            android:layout_width="match_parent"
            android:layout_height="120dp">
            <ImageView
                android:layout_marginStart="0dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:src="@drawable/subject_biology_exercise"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="习题列表"
                android:textColor="@color/white"
                android:textSize="32sp"
                android:paddingLeft="24dp"
                android:paddingTop="32dp"/>
        </androidx.cardview.widget.CardView>

        <!-- 占位空间 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <androidx.cardview.widget.CardView
            android:id="@+id/history"
            android:clickable="true"
            android:focusable="true"
            style="@style/MenuCard"
            android:layout_width="match_parent"
            android:layout_height="120dp">
            <ImageView
                android:layout_marginStart="0dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:src="@drawable/subject_biology_history"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="历史档案"
                android:textColor="@color/white"
                android:textSize="32sp"
                android:paddingLeft="24dp"
                android:paddingTop="32dp"/>
        </androidx.cardview.widget.CardView>


    </LinearLayout>

    <!-- Guideline -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.7" />

</androidx.constraintlayout.widget.ConstraintLayout>