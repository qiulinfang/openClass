<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/item_exercise_background"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="28dp"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/item_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:minHeight="24dp"
            android:textColor="@android:color/black"
            android:layout_gravity="center"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/ai_guide"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/chatbot"
            android:layout_gravity="center"
            android:stateListAnimator="@animator/button_click_scale"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/move_to_top"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@drawable/ontop"
            android:layout_gravity="center"
            android:stateListAnimator="@animator/button_click_scale"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/delete"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@drawable/delete"
            android:layout_gravity="center"
            android:stateListAnimator="@animator/button_click_scale"
            android:layout_marginEnd="8dp"/>

    </LinearLayout>

    <com.cosinetech.imates.widgets.MarkdownTextView
        android:id="@+id/question_text"
        android:clickable="true"
        android:focusable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#000000"/>
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#000000"
        android:layout_marginTop="16dp"/>
</LinearLayout>