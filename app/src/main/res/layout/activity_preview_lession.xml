<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/app_main_background">

    <TextView
        android:id="@+id/label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        android:focusable="true"
        android:text="预习"
        android:clickable="true"
        android:stateListAnimator="@animator/app_button_click_scale"
        android:textColor="#000000"
        android:textSize="@dimen/head1_size"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/preview_section_name"/>

    <TextView
        android:id="@+id/sign_split"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=" > "
        android:textColor="#000000"
        android:textSize="@dimen/head1_size"
        android:textStyle="bold"
        app:layout_constraintStart_toEndOf="@id/label"
        app:layout_constraintTop_toTopOf="@id/label" />

    <TextView
        android:id="@+id/preview_section_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="预习内容"
        android:maxLines="2"
        android:ellipsize="end"
        android:textColor="#000000"
        android:textSize="@dimen/head1_size"
        android:textStyle="bold"
        app:layout_constraintStart_toEndOf="@id/sign_split"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="@id/schema_layout"/>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_margin="16dp"
        android:background="@drawable/lesson_preview_intro_bk"
        app:layout_constraintStart_toStartOf="@id/guideline"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/h_guide_line"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.58" />

        <RelativeLayout
            android:id="@+id/intro_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/lesson_preview_intro_title_bk"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="24dp"
                android:text="教学内容简介"
                android:textStyle="bold"
                android:textSize="@dimen/head1_size"
                android:textColor="#ffffff"
                android:layout_alignParentStart="true"/>

            <TextView
                android:id="@+id/schema_stat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginVertical="24dp"
                android:layout_marginEnd="16dp"
                android:layout_centerVertical="true"
                android:text="未选择"
                android:textStyle="bold"
                android:textSize="@dimen/head1_size"
                android:layout_alignParentEnd="true"
                android:textColor="#ffffff" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:text="●"
                android:textStyle="bold"
                android:textSize="@dimen/head2_size"
                android:layout_marginEnd="16dp"
                android:layout_toStartOf="@id/schema_stat"
                android:textColor="#ffffff" />
        </RelativeLayout>

        <LinearLayout
            android:id="@+id/rate_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            app:layout_constraintTop_toBottomOf="@id/intro_title">

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="6"
                android:layout_marginHorizontal="24dp"
                android:background="@drawable/lesson_preview_split_bk"/>

            <TextView
                android:id="@+id/rate_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:text="评价"
                android:textStyle="bold"
                android:textSize="18sp"
                android:textColor="#666666" />

            <com.github.spareyaya.SimpleRatingView
                android:id="@+id/rating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="32dp"
                app:starType="heart"
                app:numStars="5"
                app:rating="0"
                app:starSize="24dp"
                app:starSpacing="2dp"
                app:primaryColor="#ff0000"
                app:secondaryColor="#cecece"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/rate_title" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:text="难度"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#666666"
                app:layout_constraintTop_toBottomOf="@id/rate_title"
                app:layout_constraintEnd_toStartOf="@id/rating_difficulty"/>

            <com.github.spareyaya.SimpleRatingView
                android:id="@+id/rating_difficulty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                app:starType="star"
                app:numStars="5"
                app:rating="0"
                app:starSize="24dp"
                app:starSpacing="2dp"
                app:primaryColor="#0000FF"
                app:secondaryColor="#cecece"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/rating" />

        </LinearLayout>

        <ScrollView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="12dp"
            android:background="@drawable/app_main_background"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/rate_layout"
            app:layout_constraintBottom_toTopOf="@id/h_guide_line">
            <com.cosinetech.imates.ui.views.MarkdownTextView
                android:id="@+id/schema_intro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="600dp"
                android:textSize="@dimen/head2_size"
                android:textColor="#000000"/>
        </ScrollView>

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="套餐资源:"
            android:layout_marginHorizontal="12dp"
            android:textColor="@color/black"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/h_guide_line"/>

        <com.cosinetech.imates.ui.views.FileDisplayView
            android:id="@+id/fileDisplayView"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="12dp"
            android:background="@drawable/app_main_background"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_title"
            app:layout_constraintBottom_toTopOf="@id/btn_go_prepare"/>

        <Button
            android:id="@+id/btn_go_prepare"
            android:layout_width="150dp"
            android:layout_height="75dp"
            android:layout_marginHorizontal="24dp"
            android:layout_marginVertical="8dp"
            android:textSize="@dimen/head2_size"
            android:textStyle="bold"
            android:textAlignment="viewStart"
            android:paddingHorizontal="20dp"
            android:background="@drawable/lesson_preview_go"
            android:textColor="#ffffff"
            android:text="去预习"
            android:stateListAnimator="@animator/app_button_click_scale"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <ScrollView
        android:id="@+id/schema_layout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:layout_margin="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/guideline"
        app:layout_constraintTop_toBottomOf="@id/preview_section_name"
        app:layout_constraintBottom_toBottomOf="parent">
        <RadioGroup
            android:id="@+id/schema_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"

            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/guideline"
            app:layout_constraintTop_toBottomOf="@id/preview_section_name"
            app:layout_constraintBottom_toBottomOf="parent">

            <RadioButton
                android:id="@+id/opt_scheme_1"
                android:layout_width="wrap_content"
                android:layout_height="100dp"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="8dp"
                android:button="@null"
                android:background="@drawable/lesson_prepare__radio_bg"
                android:text="方案一"
                android:textAlignment="center"
                android:textSize="@dimen/head1_size" />

            <RadioButton
                android:id="@+id/opt_scheme_2"
                android:layout_width="wrap_content"
                android:layout_height="100dp"

                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="8dp"
                android:button="@null"
                android:background="@drawable/lesson_prepare__radio_bg"
                android:text="方案二"
                android:textAlignment="center"
                android:textSize="@dimen/head1_size" />

            <RadioButton
                android:id="@+id/opt_scheme_3"
                android:layout_width="wrap_content"
                android:layout_height="100dp"

                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="8dp"
                android:button="@null"
                android:background="@drawable/lesson_prepare__radio_bg"
                android:text="方案三"
                android:textAlignment="center"
                android:textSize="@dimen/head1_size" />

            <RadioButton
                android:id="@+id/opt_scheme_4"
                android:layout_width="wrap_content"
                android:layout_height="100dp"

                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="8dp"
                android:button="@null"
                android:background="@drawable/lesson_prepare__radio_bg"
                android:text="方案四"
                android:textAlignment="center"
                android:textSize="@dimen/head1_size" />

            <RadioButton
                android:id="@+id/opt_scheme_5"
                android:layout_width="wrap_content"
                android:layout_height="100dp"

                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="8dp"
                android:button="@null"
                android:background="@drawable/lesson_prepare__radio_bg"
                android:text="方案五"
                android:textAlignment="center"
                android:textSize="@dimen/head1_size" />

            <RadioButton
                android:id="@+id/opt_scheme_6"
                android:layout_width="wrap_content"
                android:layout_height="100dp"

                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="8dp"
                android:button="@null"
                android:background="@drawable/lesson_prepare__radio_bg"
                android:text="方案六"
                android:textAlignment="center"
                android:textSize="@dimen/head1_size" />
        </RadioGroup>

    </ScrollView>


    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.35" />

</androidx.constraintlayout.widget.ConstraintLayout>