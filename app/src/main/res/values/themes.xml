<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->

    <style name="Theme.IMatesApp.FullScreen" parent="Theme.AppCompat.Light.NoActionBar">
        <!-- 设置全屏 -->
        <item name="android:windowFullscreen">true</item>
        <!-- 隐藏状态栏 -->
        <item name="android:windowTranslucentStatus">true</item>
        <!-- 隐藏导航栏 -->
        <item name="android:windowTranslucentNavigation">true</item>
        <item name="alertDialogTheme">@style/CustomDialog</item>
    </style>

    <style name="CustomDialog" parent="Theme.AppCompat.DayNight.Dialog.Alert">
        <item name="android:dialogCornerRadius" tools:targetApi="p">32dp</item>
    </style>

    <!-- Base application theme. -->
<!--    <style name="Base.Theme.IMatesApp.FullScreen" parent="Theme.Material3.DayNight.NoActionBar">-->
<!--        &lt;!&ndash; Customize your light theme here. &ndash;&gt;-->
<!--        &lt;!&ndash; <item name="colorPrimary">@color/my_light_primary</item> &ndash;&gt;-->
<!--    </style>-->

    <style name="Theme.IMatesApp.FullScreen.Fullscreen" parent="Theme.IMatesApp.FullScreen">
        <item name="android:actionBarStyle">
            @style/Widget.Theme.IMatesApp.FullScreen.ActionBar.Fullscreen
        </item>
        <item name="android:windowActionBarOverlay">true</item>
        <item name="android:windowBackground">@null</item>
    </style>

    <style name="ThemeOverlay.IMatesApp.FullscreenContainer" parent="">
        <item name="fullscreenBackgroundColor">@color/light_blue_600</item>
        <item name="fullscreenTextColor">@color/light_blue_A200</item>
    </style>
</resources>