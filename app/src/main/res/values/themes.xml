<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.IMatesApp" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <!-- Customize your theme here. -->
    </style>

    <style name="Theme.IMatesApp.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Theme.IMatesApp.FullScreen" parent="Theme.AppCompat.Light.NoActionBar">
        <!-- 设置全屏 -->
        <item name="android:windowFullscreen">true</item>
        <!-- 隐藏状态栏 -->
        <item name="android:windowTranslucentStatus">true</item>
        <!-- 隐藏导航栏 -->
        <item name="android:windowTranslucentNavigation">true</item>
    </style>

    <style name="Theme.IMatesApp.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

    <style name="Theme.IMatesApp.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />
</resources>