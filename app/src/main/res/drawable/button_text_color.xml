<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 按钮禁用状态 -->
    <item android:color="#808080" android:state_enabled="false" />

    <item android:color="#000000" android:state_enabled="true" />

    <item android:state_checked="true" android:drawable="@android:color/holo_blue_dark"/>

    <item android:state_checked="false" android:drawable="@android:color/black"/>

    <!-- 默认状态 -->
    <item android:color="#000000" />

</selector>