{
  "cli": {
    "version": ">= 20.5.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "INTERNAL_TEST"
      }
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "INTERNAL_TEST"
      }
    },
    "testflight": {
      "distribution": "store",
      "autoIncrement": true,
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "INTERNAL_TEST"
      }
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "RELEASE"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
