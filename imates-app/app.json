{
  "expo": {
    "name": "手机学伴",
    "slug": "imates-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/xueban-android-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cosinetech.imates.edu",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.cosinetech.imates.edu",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#3A2B86",
        "foregroundImage": "./assets/xueban-android-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-asset",
      [
        "expo-image-picker",
        {
          "photosPermission": "允许手机学伴访问相册，以便更换个人头像。",
          "cameraPermission": "允许手机学伴使用相机，以便拍照答题和上传图片。",
          "microphonePermission": false
        }
      ],
      "./plugins/with-android-app-identity"
    ],
    "extra": {
      "eas": {
        "projectId": "b275bc7e-564b-4fb3-8ac3-07483e0874a5"
      }
    }
  }
}
