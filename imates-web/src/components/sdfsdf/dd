<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>H5矢量速写板 - 文本版</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        body {
            overscroll-behavior: none;
            touch-action: none;
            background-color: #f3f4f6;
            user-select: none;
            -webkit-user-select: none;
            overflow: hidden;
        }
        canvas {
            touch-action: none;
            background-color: #ffffff;
        }
        .tool-btn {
            transition: all 0.2s;
        }
        .tool-btn.active {
            background-color: #e5e7eb;
            color: #000;
            transform: translateY(-2px);
            border-color: #3b82f6;
        }
        .tool-btn:disabled {
            opacity: 0.3;
            cursor: not-allowed;
            transform: none;
        }
        /* 光标状态 */
        .cursor-crosshair { cursor: crosshair; }
        .cursor-text { cursor: text; }
        .cursor-default { cursor: default; }
        .cursor-grab { cursor: grab; }
        .cursor-grabbing { cursor: grabbing; }

        input[type="range"] {
            accent-color: #374151;
        }
        .color-wrapper {
            position: relative;
            overflow: hidden;
            width: 32px;
            height: 32px;
            border-radius: 50%;
            border: 2px solid #e5e7eb;
            cursor: pointer;
        }
        input[type="color"] {
            position: absolute;
            left: -50%;
            top: -50%;
            width: 200%;
            height: 200%;
            cursor: pointer;
            padding: 0;
            border: none;
        }
        /* 动态生成的文本输入框样式 */
        .temp-text-input {
            position: absolute;
            background: transparent;
            border: 1px dashed #3b82f6;
            outline: none;
            padding: 0;
            margin: 0;
            resize: none;
            overflow: hidden;
            line-height: 1.2;
            font-family: sans-serif;
            z-index: 20;
            color: black;
            min-width: 50px;
        }
    </style>
</head>
<body class="h-screen w-screen flex flex-col items-center justify-center">

    <!-- 画布容器 -->
    <div id="canvas-container" class="relative w-full h-full flex items-center justify-center bg-gray-200 overflow-hidden">
        <canvas id="sketchpad" class="block"></canvas>
        
        <!-- 调试/提示信息 -->
        <div id="debug-info" class="absolute top-4 left-4 text-xs text-gray-400 pointer-events-none select-none hidden sm:block">
            Scale: 100% | Pos: 0, 0
        </div>
    </div>

    <!-- 工具栏 -->
    <div class="absolute bottom-6 left-1/2 transform -translate-x-1/2 bg-white px-4 py-3 rounded-2xl shadow-xl border border-gray-200 flex items-center gap-3 w-[98%] max-w-3xl justify-between z-10 overflow-x-auto">
        
        <!-- 工具组 -->
        <div class="flex gap-2 flex-shrink-0">
            <button id="btn-select" class="tool-btn p-2 rounded-lg border border-transparent hover:bg-gray-100" title="选择/移动 (V)">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3l7.07 16.97 2.51-7.39 7.39-2.51L3 3z"></path><path d="M13 13l6 6"></path></svg>
            </button>
            <button id="btn-pen" class="tool-btn active p-2 rounded-lg border border-transparent hover:bg-gray-100" title="画笔 (P)">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19l7-7 3 3-7 7-3-3z"></path><path d="M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-11z"></path><path d="M2 2l7.5 8.6"></path><path d="M22 22l-5.5-5.5"></path></svg>
            </button>
            <button id="btn-eraser" class="tool-btn p-2 rounded-lg border border-transparent hover:bg-gray-100" title="橡皮擦 (E)">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 20H7L3 16C2 15 2 13 3 12L13 2L22 11L20 20Z"></path><path d="M17 17L7 7"></path></svg>
            </button>
            <button id="btn-text" class="tool-btn p-2 rounded-lg border border-transparent hover:bg-gray-100" title="插入文本 (T)">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7V4h16v3"></path><path d="M9 20h6"></path><path d="M12 4v16"></path></svg>
            </button>
        </div>

        <div class="w-px h-8 bg-gray-200 flex-shrink-0"></div>

        <!-- 属性调节 -->
        <div class="flex items-center gap-3 flex-1 justify-center min-w-[100px]">
            <div class="color-wrapper shadow-sm flex-shrink-0" id="color-preview">
                <input type="color" id="color-picker" value="#000000">
            </div>
            
            <div class="flex flex-col w-full max-w-[100px]">
                <input type="range" id="line-width" min="1" max="50" value="3" class="w-full h-1 bg-gray-200 rounded-lg appearance-none cursor-pointer" title="笔触/字体大小">
            </div>
        </div>

        <div class="w-px h-8 bg-gray-200 flex-shrink-0"></div>

        <!-- 撤销/重做/保存 -->
        <div class="flex gap-2 flex-shrink-0">
            <button id="btn-undo" class="tool-btn p-2 rounded-lg border border-transparent hover:bg-gray-100 disabled:opacity-30 disabled:cursor-not-allowed" title="撤销 (Ctrl+Z)">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7v6h6"></path><path d="M21 17a9 9 0 0 0-9-9 9 9 0 0 0-6 2.3L3 13"></path></svg>
            </button>
            <button id="btn-redo" class="tool-btn p-2 rounded-lg border border-transparent hover:bg-gray-100 disabled:opacity-30 disabled:cursor-not-allowed" title="重做 (Ctrl+Y)">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 7v6h-6"></path><path d="M3 17a9 9 0 0 1 9-9 9 9 0 0 1 6 2.3l3 2.7"></path></svg>
            </button>
            
            <div class="w-px h-8 bg-gray-200 mx-1"></div>

            <button id="btn-reset-view" class="tool-btn p-2 rounded-lg border border-transparent hover:bg-gray-100" title="重置视图">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="16"></line><line x1="8" y1="12" x2="16" y2="12"></line></svg>
            </button>
            <button id="btn-clear" class="tool-btn p-2 rounded-lg border border-transparent hover:bg-gray-100 text-red-500" title="清空">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
            </button>
            <button id="btn-save" class="tool-btn p-2 rounded-lg border border-transparent hover:bg-gray-100 text-blue-600" title="保存">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
            </button>
        </div>
    </div>

    <div id="status-toast" class="absolute top-4 left-1/2 transform -translate-x-1/2 bg-black bg-opacity-70 text-white px-4 py-1 rounded-full text-xs opacity-0 transition-opacity duration-300 pointer-events-none z-50">
        已保存
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const canvas = document.getElementById('sketchpad');
            const ctx = canvas.getContext('2d', { alpha: false });
            const container = document.getElementById('canvas-container');
            const debugInfo = document.getElementById('debug-info');
            
            // --- 核心数据结构 ---
            // stroke: { type: 'stroke', points: [], color, size, mode, bounds }
            // text:   { type: 'text', x, y, text, color, size, font, bounds }
            let strokes = []; 
            let history = []; 
            let historyStep = -1;
            const MAX_HISTORY = 30;

            // --- 视图状态 ---
            let camera = { x: 0, y: 0, zoom: 1 };
            const MIN_ZOOM = 0.1;
            const MAX_ZOOM = 5.0;

            // --- 交互状态 ---
            let activePointers = new Map();
            let isSpacePressed = false;
            let currentMode = 'pen'; // 'pen', 'eraser', 'select', 'text', 'pan'
            let currentColor = '#000000';
            let currentSize = 3;
            
            let activeAction = null; 
            let selectedStrokeIndex = -1;
            let isTyping = false; // 是否正在输入文本

            // --- DOM 元素 ---
            const btnSelect = document.getElementById('btn-select');
            const btnPen = document.getElementById('btn-pen');
            const btnEraser = document.getElementById('btn-eraser');
            const btnText = document.getElementById('btn-text');
            const btnUndo = document.getElementById('btn-undo');
            const btnRedo = document.getElementById('btn-redo');
            const btnClear = document.getElementById('btn-clear');
            const btnSave = document.getElementById('btn-save');
            const btnResetView = document.getElementById('btn-reset-view');
            const colorPicker = document.getElementById('color-picker');
            const colorPreview = document.getElementById('color-preview');
            const sizeSlider = document.getElementById('line-width');
            const toast = document.getElementById('status-toast');

            // --- 坐标系统转换 ---
            function screenToWorld(sx, sy) {
                const rect = canvas.getBoundingClientRect();
                const x = (sx - rect.left - camera.x) / camera.zoom;
                const y = (sy - rect.top - camera.y) / camera.zoom;
                return { x, y };
            }

            function worldToScreen(wx, wy) {
                const rect = canvas.getBoundingClientRect();
                const sx = wx * camera.zoom + camera.x + rect.left;
                const sy = wy * camera.zoom + camera.y + rect.top;
                return { x: sx, y: sy };
            }

            function getDistance(p1, p2) {
                return Math.sqrt(Math.pow(p2.x - p1.x, 2) + Math.pow(p2.y - p1.y, 2));
            }

            function getCenter(p1, p2) {
                return { x: (p1.x + p2.x) / 2, y: (p1.y + p2.y) / 2 };
            }

            // --- 渲染引擎 ---
            function resizeCanvas() {
                const width = container.clientWidth;
                const height = container.clientHeight;
                const dpr = window.devicePixelRatio || 1;
                
                if (canvas.width !== width * dpr || canvas.height !== height * dpr) {
                    canvas.width = width * dpr;
                    canvas.height = height * dpr;
                    canvas.style.width = `${width}px`;
                    canvas.style.height = `${height}px`;
                    renderAll();
                }
            }

            function drawGrid(ctx, width, height) {
                const zoom = camera.zoom;
                const step = 20 * zoom;
                let gridSize = 20;
                if (step < 10) gridSize = 100;
                if (step < 2) return; 

                const offsetX = camera.x % (gridSize * zoom);
                const offsetY = camera.y % (gridSize * zoom);

                ctx.beginPath();
                ctx.strokeStyle = '#e5e7eb';
                ctx.lineWidth = 1;

                for (let x = offsetX; x < width; x += gridSize * zoom) {
                    ctx.moveTo(x, 0);
                    ctx.lineTo(x, height);
                }
                for (let y = offsetY; y < height; y += gridSize * zoom) {
                    ctx.moveTo(0, y);
                    ctx.lineTo(width, y);
                }
                ctx.stroke();

                // 原点
                const originX = camera.x;
                const originY = camera.y;
                ctx.beginPath();
                ctx.strokeStyle = '#d1d5db';
                ctx.lineWidth = 2;
                ctx.moveTo(originX - 10, originY);
                ctx.lineTo(originX + 10, originY);
                ctx.moveTo(originX, originY - 10);
                ctx.lineTo(originX, originY + 10);
                ctx.stroke();
            }

            function renderAll() {
                const dpr = window.devicePixelRatio || 1;
                const width = canvas.width;
                const height = canvas.height;

                ctx.setTransform(1, 0, 0, 1, 0, 0);
                ctx.fillStyle = '#f9fafb';
                ctx.fillRect(0, 0, width, height);

                drawGrid(ctx, width, height);

                // 应用摄像机
                ctx.setTransform(dpr * camera.zoom, 0, 0, dpr * camera.zoom, camera.x * dpr, camera.y * dpr);
                ctx.lineCap = 'round';
                ctx.lineJoin = 'round';

                strokes.forEach((obj, index) => {
                    const isSelected = (index === selectedStrokeIndex && currentMode === 'select');

                    if (!obj.type || obj.type === 'stroke') {
                        // 绘制线条
                        if (obj.points.length === 0) return;
                        ctx.beginPath();
                        ctx.lineWidth = obj.size;
                        ctx.strokeStyle = obj.mode === 'eraser' ? '#f9fafb' : obj.color;

                        if (obj.points.length < 2) {
                            ctx.moveTo(obj.points[0].x, obj.points[0].y);
                            ctx.lineTo(obj.points[0].x, obj.points[0].y);
                        } else {
                            ctx.moveTo(obj.points[0].x, obj.points[0].y);
                            for (let i = 1; i < obj.points.length - 1; i++) {
                                const p1 = obj.points[i];
                                const p2 = obj.points[i + 1];
                                const midX = (p1.x + p2.x) / 2;
                                const midY = (p1.y + p2.y) / 2;
                                ctx.quadraticCurveTo(p1.x, p1.y, midX, midY);
                            }
                            const last = obj.points[obj.points.length - 1];
                            ctx.lineTo(last.x, last.y);
                        }
                        ctx.stroke();
                    } else if (obj.type === 'text') {
                        // 绘制文本
                        ctx.font = `${obj.size * 5}px sans-serif`; // 字体大小倍率
                        ctx.fillStyle = obj.color;
                        ctx.textBaseline = 'top';
                        // 多行文本支持
                        const lines = obj.text.split('\n');
                        const lineHeight = obj.size * 5 * 1.2;
                        lines.forEach((line, i) => {
                            ctx.fillText(line, obj.x, obj.y + i * lineHeight);
                        });
                        
                        // 更新文本包围盒 (用于后续选中)
                        // 简单估算，不精确但高效
                        const maxWidth = Math.max(...lines.map(l => ctx.measureText(l).width));
                        obj.bounds = {
                            minX: obj.x,
                            maxX: obj.x + maxWidth,
                            minY: obj.y,
                            maxY: obj.y + lines.length * lineHeight
                        };
                    }

                    if (isSelected) {
                        drawSelectionBox(obj);
                    }
                });

                debugInfo.textContent = `Scale: ${Math.round(camera.zoom * 100)}% | Pos: ${Math.round(camera.x)}, ${Math.round(camera.y)}`;
                updateCursor();
            }

            function drawSelectionBox(obj) {
                const padding = 5;
                const b = obj.bounds;
                ctx.save();
                ctx.strokeStyle = '#3b82f6';
                ctx.lineWidth = 1 / camera.zoom;
                ctx.setLineDash([5 / camera.zoom, 3 / camera.zoom]);
                
                // 处理线条宽度带来的包围盒扩张
                const expand = (obj.type === 'text') ? 0 : obj.size / 2;
                
                ctx.strokeRect(
                    b.minX - padding - expand, 
                    b.minY - padding - expand, 
                    (b.maxX - b.minX) + padding * 2 + expand * 2, 
                    (b.maxY - b.minY) + padding * 2 + expand * 2
                );
                ctx.restore();
            }

            function updateCursor() {
                const list = canvas.classList;
                list.remove('cursor-crosshair', 'cursor-default', 'cursor-grab', 'cursor-grabbing', 'cursor-text');

                if (isSpacePressed || (activeAction && activeAction.type === 'pan')) {
                    list.add('cursor-grabbing');
                } else if (isSpacePressed) {
                    list.add('cursor-grab');
                } else if (currentMode === 'select') {
                    list.add('cursor-default');
                } else if (currentMode === 'text') {
                    list.add('cursor-text');
                } else {
                    list.add('cursor-crosshair');
                }
            }

            // --- 撤销/重做 ---
            function saveState() {
                const snapshot = JSON.stringify(strokes);
                // 如果在历史记录中间进行了操作，截断后面的记录
                if (historyStep < history.length - 1) {
                    history = history.slice(0, historyStep + 1);
                }
                
                if (history.length >= MAX_HISTORY) {
                    history.shift();
                    historyStep--;
                }
                history.push(snapshot);
                historyStep++;
                updateHistoryButtons();
            }
            saveState(); // Init

            function undo() {
                if (historyStep > 0) {
                    historyStep--;
                    loadState(history[historyStep]);
                }
                updateHistoryButtons();
            }

            function redo() {
                if (historyStep < history.length - 1) {
                    historyStep++;
                    loadState(history[historyStep]);
                }
                updateHistoryButtons();
            }

            function loadState(jsonStr) {
                try {
                    strokes = JSON.parse(jsonStr);
                    selectedStrokeIndex = -1;
                    renderAll();
                } catch (e) { console.error(e); }
            }

            function updateHistoryButtons() {
                btnUndo.disabled = historyStep <= 0;
                btnUndo.style.opacity = historyStep <= 0 ? '0.3' : '1';
                
                btnRedo.disabled = historyStep >= history.length - 1;
                btnRedo.style.opacity = historyStep >= history.length - 1 ? '0.3' : '1';
            }

            // --- 碰撞检测 ---
            function hitTest(wx, wy) {
                for (let i = strokes.length - 1; i >= 0; i--) {
                    const s = strokes[i];
                    const padding = (s.type === 'text' ? 10 : Math.max(s.size, 5)) / camera.zoom + 5;

                    // 1. 包围盒粗测
                    const expand = (s.type === 'text') ? 0 : s.size / 2;
                    if (wx < s.bounds.minX - padding - expand || wx > s.bounds.maxX + padding + expand ||
                        wy < s.bounds.minY - padding - expand || wy > s.bounds.maxY + padding + expand) {
                        continue;
                    }

                    // 2. 详细检测
                    if (s.type === 'text') {
                        // 文本只要在包围盒内就算选中
                        return i;
                    } else {
                        // 线条检测点距离
                        for (let j = 0; j < s.points.length; j++) {
                            const p = s.points[j];
                            const dist = Math.sqrt((wx - p.x)**2 + (wy - p.y)**2);
                            if (dist < s.size / 2 + 5 / camera.zoom) return i;
                        }
                    }
                }
                return -1;
            }

            // --- 文本输入处理 ---
            function createTextInput(worldX, worldY) {
                isTyping = true;
                const input = document.createElement('textarea');
                input.className = 'temp-text-input';
                document.body.appendChild(input);

                // 定位输入框 (转换为屏幕坐标)
                const screenPos = worldToScreen(worldX, worldY);
                input.style.left = `${screenPos.x}px`;
                input.style.top = `${screenPos.y}px`;
                
                // 字体大小适应缩放
                const fontSize = currentSize * 5 * camera.zoom;
                input.style.fontSize = `${fontSize}px`;
                input.style.color = currentColor;
                
                // 自动聚焦
                input.focus();

                function finishInput() {
                    if (!isTyping) return; // 防止多次触发
                    const text = input.value.trim();
                    if (text) {
                        const fontSizeBase = currentSize; 
                        // 创建文本对象
                        // 注意：bounds将在第一次渲染时计算
                        const textObj = {
                            type: 'text',
                            x: worldX,
                            y: worldY,
                            text: text,
                            color: currentColor,
                            size: fontSizeBase,
                            bounds: { minX: worldX, maxX: worldX, minY: worldY, maxY: worldY }
                        };
                        strokes.push(textObj);
                        saveState();
                        renderAll();
                    }
                    
                    isTyping = false;
                    document.body.removeChild(input);
                    
                    // 切回选择模式或保持文本模式？通常保持文本模式方便连续输入
                    // 这里保持原样
                }

                // 事件处理
                input.addEventListener('blur', finishInput);
                input.addEventListener('keydown', (e) => {
                    // Enter 换行，Ctrl+Enter 或 Esc 完成
                    if (e.key === 'Escape') {
                        finishInput();
                    }
                    e.stopPropagation(); // 阻止冒泡防止触发快捷键
                });

                // 自动调整高度
                input.addEventListener('input', () => {
                    input.style.height = 'auto';
                    input.style.height = input.scrollHeight + 'px';
                });
            }


            // --- 指针事件处理 ---
            canvas.addEventListener('pointerdown', (e) => {
                if (isTyping) return; // 如果正在输入，忽略画布点击（输入框blur会自动处理）
                
                e.preventDefault();
                canvas.setPointerCapture(e.pointerId);
                activePointers.set(e.pointerId, { x: e.clientX, y: e.clientY });

                // 双指手势
                if (activePointers.size === 2) {
                    if (activeAction && activeAction.type === 'draw') strokes.pop();
                    const pts = Array.from(activePointers.values());
                    activeAction = {
                        type: 'gesture',
                        startDist: getDistance(pts[0], pts[1]),
                        startZoom: camera.zoom,
                        startCenter: getCenter(pts[0], pts[1]),
                        startCamera: { ...camera }
                    };
                    return;
                }
                if (activePointers.size > 2) return;

                // 转换坐标
                const worldPos = screenToWorld(e.clientX, e.clientY);

                // 空格键平移
                if (isSpacePressed) {
                    activeAction = { type: 'pan', lastPos: { x: e.clientX, y: e.clientY } };
                    updateCursor();
                    return;
                }

                if (currentMode === 'text') {
                    // 点击创建文本框
                    createTextInput(worldPos.x, worldPos.y);
                    return;
                }

                if (currentMode === 'select') {
                    const hitIndex = hitTest(worldPos.x, worldPos.y);
                    if (hitIndex !== -1) {
                        selectedStrokeIndex = hitIndex;
                        activeAction = {
                            type: 'select',
                            index: hitIndex,
                            lastPos: worldPos
                        };
                        renderAll();
                    } else {
                        // 没点中则平移
                        activeAction = { type: 'pan', lastPos: { x: e.clientX, y: e.clientY } };
                        if (selectedStrokeIndex !== -1) {
                            selectedStrokeIndex = -1;
                            renderAll();
                        }
                    }
                } else {
                    // 画笔/橡皮
                    if (selectedStrokeIndex !== -1) {
                        selectedStrokeIndex = -1;
                        renderAll();
                    }
                    const newStroke = {
                        type: 'stroke',
                        points: [{ x: worldPos.x, y: worldPos.y }],
                        color: currentColor,
                        size: parseInt(currentSize),
                        mode: currentMode,
                        bounds: { minX: worldPos.x, maxX: worldPos.x, minY: worldPos.y, maxY: worldPos.y }
                    };
                    strokes.push(newStroke);
                    activeAction = { type: 'draw', stroke: newStroke };
                    renderAll();
                }
            });

            window.addEventListener('pointermove', (e) => {
                if (!activePointers.has(e.pointerId)) return;
                e.preventDefault();
                activePointers.set(e.pointerId, { x: e.clientX, y: e.clientY });

                if (!activeAction) return;

                if (activeAction.type === 'gesture' && activePointers.size === 2) {
                    const pts = Array.from(activePointers.values());
                    const dist = getDistance(pts[0], pts[1]);
                    const center = getCenter(pts[0], pts[1]);
                    
                    const scaleFactor = dist / activeAction.startDist;
                    let newZoom = Math.max(MIN_ZOOM, Math.min(MAX_ZOOM, activeAction.startZoom * scaleFactor));
                    
                    // Zoom around center
                    const rect = canvas.getBoundingClientRect();
                    const startCenterRel = { x: activeAction.startCenter.x - rect.left, y: activeAction.startCenter.y - rect.top };
                    const wx = (startCenterRel.x - activeAction.startCamera.x) / activeAction.startZoom;
                    const wy = (startCenterRel.y - activeAction.startCamera.y) / activeAction.startZoom;
                    const newCenterRel = { x: center.x - rect.left, y: center.y - rect.top };

                    camera.zoom = newZoom;
                    camera.x = newCenterRel.x - wx * newZoom;
                    camera.y = newCenterRel.y - wy * newZoom;
                    renderAll();
                } 
                else if (activeAction.type === 'pan') {
                    const dx = e.clientX - activeAction.lastPos.x;
                    const dy = e.clientY - activeAction.lastPos.y;
                    camera.x += dx;
                    camera.y += dy;
                    activeAction.lastPos = { x: e.clientX, y: e.clientY };
                    renderAll();
                }
                else if (activeAction.type === 'draw') {
                    const events = e.getCoalescedEvents ? e.getCoalescedEvents() : [e];
                    const stroke = activeAction.stroke;
                    events.forEach(ev => {
                        const wp = screenToWorld(ev.clientX, ev.clientY);
                        stroke.points.push(wp);
                        // bounds update
                        if (wp.x < stroke.bounds.minX) stroke.bounds.minX = wp.x;
                        if (wp.x > stroke.bounds.maxX) stroke.bounds.maxX = wp.x;
                        if (wp.y < stroke.bounds.minY) stroke.bounds.minY = wp.y;
                        if (wp.y > stroke.bounds.maxY) stroke.bounds.maxY = wp.y;
                    });
                    renderAll();
                }
                else if (activeAction.type === 'select') {
                    const wp = screenToWorld(e.clientX, e.clientY);
                    const dx = wp.x - activeAction.lastPos.x;
                    const dy = wp.y - activeAction.lastPos.y;
                    
                    const obj = strokes[activeAction.index];
                    
                    if (obj.type === 'text') {
                        obj.x += dx;
                        obj.y += dy;
                        obj.bounds.minX += dx; obj.bounds.maxX += dx;
                        obj.bounds.minY += dy; obj.bounds.maxY += dy;
                    } else {
                        obj.points.forEach(p => { p.x += dx; p.y += dy; });
                        obj.bounds.minX += dx; obj.bounds.maxX += dx;
                        obj.bounds.minY += dy; obj.bounds.maxY += dy;
                    }
                    
                    activeAction.lastPos = wp;
                    renderAll();
                }
            });

            function endAction(e) {
                activePointers.delete(e.pointerId);
                if (activePointers.size === 0) {
                    if (activeAction && (activeAction.type === 'draw' || activeAction.type === 'select')) {
                        saveState();
                    }
                    activeAction = null;
                } else if (activeAction && activeAction.type === 'gesture') {
                    activeAction = null;
                }
                updateCursor();
            }

            window.addEventListener('pointerup', endAction);
            window.addEventListener('pointercancel', endAction);
            window.addEventListener('pointerout', (e) => {
                if (e.target === document.body || e.target === document.documentElement) {
                    endAction(e);
                }
            });

            // --- 滚轮缩放 ---
            canvas.addEventListener('wheel', (e) => {
                e.preventDefault();
                const zoomIntensity = 0.1;
                const delta = -Math.sign(e.deltaY);
                const scale = Math.exp(delta * zoomIntensity);
                
                const oldZoom = camera.zoom;
                let newZoom = Math.max(MIN_ZOOM, Math.min(MAX_ZOOM, oldZoom * scale));
                
                const rect = canvas.getBoundingClientRect();
                const mouseX = e.clientX - rect.left;
                const mouseY = e.clientY - rect.top;
                const wx = (mouseX - camera.x) / oldZoom;
                const wy = (mouseY - camera.y) / oldZoom;
                
                camera.x = mouseX - wx * newZoom;
                camera.y = mouseY - wy * newZoom;
                camera.zoom = newZoom;
                renderAll();
            }, { passive: false });

            // --- 快捷键 ---
            window.addEventListener('keydown', (e) => {
                if (isTyping) return; // 输入时不触发快捷键

                if (e.code === 'Space' && !isSpacePressed) {
                    isSpacePressed = true;
                    updateCursor();
                }
                
                // Ctrl+Z / Ctrl+Y
                if ((e.ctrlKey || e.metaKey)) {
                    if (e.key === 'z' || e.key === 'Z') {
                        e.preventDefault();
                        undo();
                    }
                    if (e.key === 'y' || e.key === 'Y') {
                        e.preventDefault();
                        redo();
                    }
                }
                
                if (e.key === 'v' || e.key === 'V') btnSelect.click();
                if (e.key === 'p' || e.key === 'P') btnPen.click();
                if (e.key === 'e' || e.key === 'E') btnEraser.click();
                if (e.key === 't' || e.key === 'T') btnText.click();
            });

            window.addEventListener('keyup', (e) => {
                if (e.code === 'Space') {
                    isSpacePressed = false;
                    if (activeAction && activeAction.type === 'pan' && !activePointers.size) activeAction = null;
                    updateCursor();
                }
            });

            // --- UI 事件 ---
            function setMode(mode) {
                currentMode = mode;
                [btnPen, btnEraser, btnSelect, btnText].forEach(btn => btn.classList.remove('active', 'border-blue-500'));
                
                const map = { 'pen': btnPen, 'eraser': btnEraser, 'select': btnSelect, 'text': btnText };
                if (map[mode]) {
                    map[mode].classList.add('active');
                    map[mode].style.borderColor = '#3b82f6';
                }
                
                if (mode !== 'select') {
                    selectedStrokeIndex = -1;
                    renderAll();
                }
                updateCursor();
            }

            btnSelect.addEventListener('click', () => setMode('select'));
            btnPen.addEventListener('click', () => setMode('pen'));
            btnEraser.addEventListener('click', () => setMode('eraser'));
            btnText.addEventListener('click', () => setMode('text'));

            colorPicker.addEventListener('input', (e) => {
                currentColor = e.target.value;
                colorPreview.style.backgroundColor = currentColor;
                if (currentMode === 'eraser' || currentMode === 'select') setMode('pen');
            });

            sizeSlider.addEventListener('input', (e) => currentSize = parseInt(e.target.value));
            
            btnUndo.addEventListener('click', undo);
            btnRedo.addEventListener('click', redo);
            
            btnResetView.addEventListener('click', () => {
                camera = { x: 0, y: 0, zoom: 1 };
                renderAll();
            });

            btnClear.addEventListener('click', () => {
                if (strokes.length > 0 && confirm('清空画布？')) {
                    strokes = [];
                    selectedStrokeIndex = -1;
                    renderAll();
                    saveState();
                }
            });

            btnSave.addEventListener('click', () => {
                const prevSelection = selectedStrokeIndex;
                selectedStrokeIndex = -1;
                renderAll();
                
                const link = document.createElement('a');
                link.download = `sketch_${Date.now()}.png`;
                link.href = canvas.toDataURL(); 
                link.click();
                
                selectedStrokeIndex = prevSelection;
                renderAll();
                
                toast.style.opacity = '1';
                setTimeout(() => toast.style.opacity = '0', 2000);
            });

            window.addEventListener('resize', () => {
                clearTimeout(window.resizeTimer);
                window.resizeTimer = setTimeout(resizeCanvas, 100);
            });

            // Init
            setMode('pen');
            resizeCanvas();
        });
    </script>
</body>
</html>