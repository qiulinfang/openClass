<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>H5速写板</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        body {
            overscroll-behavior: none;
            touch-action: none;
            background-color: #f3f4f6;
            user-select: none;
            -webkit-user-select: none;
        }
        canvas {
            touch-action: none;
            cursor: crosshair;
            background-color: #ffffff;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
            /* 确保浏览器不使用最近邻插值，保持平滑 */
            image-rendering: auto; 
        }
        .tool-btn {
            transition: all 0.2s;
        }
        .tool-btn.active {
            background-color: #e5e7eb;
            color: #000;
            transform: translateY(-2px);
            border-color: #3b82f6;
        }
        input[type="range"] {
            accent-color: #374151;
        }
        .color-wrapper {
            position: relative;
            overflow: hidden;
            width: 32px;
            height: 32px;
            border-radius: 50%;
            border: 2px solid #e5e7eb;
            cursor: pointer;
        }
        input[type="color"] {
            position: absolute;
            left: -50%;
            top: -50%;
            width: 200%;
            height: 200%;
            cursor: pointer;
            padding: 0;
            border: none;
        }
    </style>
</head>
<body class="h-screen w-screen flex flex-col items-center justify-center overflow-hidden">

    <!-- 画布容器 -->
    <div id="canvas-container" class="relative w-full h-full flex items-center justify-center bg-gray-100">
        <canvas id="sketchpad"></canvas>
    </div>

    <!-- 工具栏 -->
    <div class="absolute bottom-6 left-1/2 transform -translate-x-1/2 bg-white px-4 py-3 rounded-2xl shadow-xl border border-gray-200 flex items-center gap-4 w-[90%] max-w-lg justify-between z-10">
        
        <!-- 画笔/橡皮擦切换 -->
        <div class="flex gap-2">
            <button id="btn-pen" class="tool-btn active p-2 rounded-lg border border-transparent hover:bg-gray-100" title="画笔">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19l7-7 3 3-7 7-3-3z"></path><path d="M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-11z"></path><path d="M2 2l7.5 8.6"></path><path d="M22 22l-5.5-5.5"></path></svg>
            </button>
            <button id="btn-eraser" class="tool-btn p-2 rounded-lg border border-transparent hover:bg-gray-100" title="橡皮擦">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 20H7L3 16C2 15 2 13 3 12L13 2L22 11L20 20Z"></path><path d="M17 17L7 7"></path></svg>
            </button>
        </div>

        <div class="w-px h-8 bg-gray-200"></div>

        <!-- 属性调节 -->
        <div class="flex items-center gap-3 flex-1 justify-center">
            <div class="color-wrapper shadow-sm" id="color-preview">
                <input type="color" id="color-picker" value="#000000">
            </div>
            
            <div class="flex flex-col w-24">
                <input type="range" id="line-width" min="1" max="50" value="3" class="w-full h-1 bg-gray-200 rounded-lg appearance-none cursor-pointer">
            </div>
        </div>

        <div class="w-px h-8 bg-gray-200"></div>

        <!-- 操作按钮 -->
        <div class="flex gap-2">
            <button id="btn-undo" class="tool-btn p-2 rounded-lg border border-transparent hover:bg-gray-100 disabled:opacity-30 disabled:cursor-not-allowed" title="撤销">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7v6h6"></path><path d="M21 17a9 9 0 0 0-9-9 9 9 0 0 0-6 2.3L3 13"></path></svg>
            </button>
            <button id="btn-clear" class="tool-btn p-2 rounded-lg border border-transparent hover:bg-gray-100 text-red-500" title="清空">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
            </button>
            <button id="btn-save" class="tool-btn p-2 rounded-lg border border-transparent hover:bg-gray-100 text-blue-600" title="保存">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
            </button>
        </div>
    </div>

    <!-- 顶部状态提示 -->
    <div id="status-toast" class="absolute top-4 left-1/2 transform -translate-x-1/2 bg-black bg-opacity-70 text-white px-4 py-1 rounded-full text-xs opacity-0 transition-opacity duration-300 pointer-events-none">
        已保存
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const canvas = document.getElementById('sketchpad');
            const ctx = canvas.getContext('2d', { willReadFrequently: true });
            const container = document.getElementById('canvas-container');
            
            // 状态变量
            let isDrawing = false;
            let lastPoint = { x: 0, y: 0 };
            let lastMidPoint = { x: 0, y: 0 };
            
            let history = [];
            let historyStep = -1;
            const MAX_HISTORY = 20;

            // 工具状态
            let currentMode = 'pen';
            let currentColor = '#000000';
            let currentSize = 3;

            // DOM 元素
            const btnPen = document.getElementById('btn-pen');
            const btnEraser = document.getElementById('btn-eraser');
            const btnUndo = document.getElementById('btn-undo');
            const btnClear = document.getElementById('btn-clear');
            const btnSave = document.getElementById('btn-save');
            const colorPicker = document.getElementById('color-picker');
            const colorPreview = document.getElementById('color-preview');
            const sizeSlider = document.getElementById('line-width');
            const toast = document.getElementById('status-toast');

            // 初始化画布尺寸
            function resizeCanvas() {
                let imgData = null;
                if (canvas.width > 0) {
                    imgData = ctx.getImageData(0, 0, canvas.width, canvas.height);
                }

                const width = container.clientWidth;
                const height = container.clientHeight;
                const dpr = window.devicePixelRatio || 1;
                
                canvas.width = width * dpr;
                canvas.height = height * dpr;
                canvas.style.width = `${width}px`;
                canvas.style.height = `${height}px`;
                
                ctx.scale(dpr, dpr);
                ctx.lineCap = 'round';
                ctx.lineJoin = 'round';
                
                if (!imgData) {
                    ctx.fillStyle = '#ffffff';
                    ctx.fillRect(0, 0, width, height);
                    saveState();
                } else {
                    ctx.putImageData(imgData, 0, 0);
                }
                updateContextStyle();
            }

            function updateContextStyle() {
                if (currentMode === 'eraser') {
                    ctx.strokeStyle = '#ffffff';
                } else {
                    ctx.strokeStyle = currentColor;
                }
                ctx.lineWidth = currentSize;
                ctx.lineCap = 'round';
                ctx.lineJoin = 'round';
            }

            function saveState() {
                if (historyStep < history.length - 1) {
                    history = history.slice(0, historyStep + 1);
                }
                if (history.length >= MAX_HISTORY) {
                    history.shift();
                    historyStep--;
                }
                history.push(canvas.toDataURL());
                historyStep++;
                updateUndoButton();
            }

            function undo() {
                if (historyStep > 0) {
                    historyStep--;
                    const img = new Image();
                    img.src = history[historyStep];
                    img.onload = () => {
                        ctx.globalCompositeOperation = 'source-over';
                        ctx.clearRect(0, 0, canvas.width / window.devicePixelRatio, canvas.height / window.devicePixelRatio);
                        ctx.drawImage(img, 0, 0, canvas.width / window.devicePixelRatio, canvas.height / window.devicePixelRatio);
                    };
                }
                updateUndoButton();
            }

            function updateUndoButton() {
                btnUndo.disabled = historyStep <= 0;
                btnUndo.style.opacity = historyStep <= 0 ? '0.3' : '1';
            }

            // 获取相对坐标
            function getCoordinates(e) {
                const rect = canvas.getBoundingClientRect();
                return {
                    x: e.clientX - rect.left,
                    y: e.clientY - rect.top
                };
            }

            // 绘图逻辑 - 使用Pointer Events
            function startDrawing(e) {
                if(e.button !== 0) return; // 只响应左键
                e.preventDefault();
                isDrawing = true;
                
                const { x, y } = getCoordinates(e);
                lastPoint = { x, y };
                lastMidPoint = { x, y };
                
                // 绘制单点（防止点击无反应）
                ctx.beginPath();
                ctx.moveTo(x, y);
                ctx.lineTo(x, y);
                ctx.stroke();
            }

            function draw(e) {
                if (!isDrawing) return;
                e.preventDefault();

                // 获取聚合事件（提高高采样率设备上的精度）
                const events = e.getCoalescedEvents ? e.getCoalescedEvents() : [e];

                events.forEach(event => {
                    const currentPoint = getCoordinates(event);
                    
                    // 计算中点
                    const currentMidPoint = {
                        x: (lastPoint.x + currentPoint.x) / 2,
                        y: (lastPoint.y + currentPoint.y) / 2
                    };

                    // 使用二次贝塞尔曲线连接前一个中点和当前中点
                    // 控制点为前一个原始点 (lastPoint)
                    ctx.beginPath();
                    ctx.moveTo(lastMidPoint.x, lastMidPoint.y);
                    ctx.quadraticCurveTo(lastPoint.x, lastPoint.y, currentMidPoint.x, currentMidPoint.y);
                    ctx.stroke();

                    // 更新坐标
                    lastPoint = currentPoint;
                    lastMidPoint = currentMidPoint;
                });
            }

            function stopDrawing() {
                if (isDrawing) {
                    isDrawing = false;
                    saveState();
                }
            }

            // 使用 Pointer Events 统一处理鼠标和触摸
            canvas.addEventListener('pointerdown', startDrawing);
            canvas.addEventListener('pointermove', draw);
            canvas.addEventListener('pointerup', stopDrawing);
            canvas.addEventListener('pointerout', stopDrawing);
            canvas.addEventListener('pointercancel', stopDrawing); // 处理意外中断

            // 工具栏逻辑保持不变
            btnPen.addEventListener('click', () => {
                currentMode = 'pen';
                btnPen.classList.add('active');
                btnEraser.classList.remove('active');
                btnPen.style.borderColor = '#3b82f6';
                btnEraser.style.borderColor = 'transparent';
                updateContextStyle();
            });

            btnEraser.addEventListener('click', () => {
                currentMode = 'eraser';
                btnEraser.classList.add('active');
                btnPen.classList.remove('active');
                btnEraser.style.borderColor = '#3b82f6';
                btnPen.style.borderColor = 'transparent';
                updateContextStyle();
            });

            colorPicker.addEventListener('input', (e) => {
                currentColor = e.target.value;
                colorPreview.style.backgroundColor = currentColor;
                if (currentMode === 'eraser') {
                    btnPen.click();
                }
                updateContextStyle();
            });

            sizeSlider.addEventListener('input', (e) => {
                currentSize = e.target.value;
                updateContextStyle();
            });

            btnUndo.addEventListener('click', undo);

            btnClear.addEventListener('click', () => {
                if (confirm('确定要清空画布吗？')) {
                    const width = canvas.width / window.devicePixelRatio;
                    const height = canvas.height / window.devicePixelRatio;
                    ctx.fillStyle = '#ffffff';
                    ctx.fillRect(0, 0, width, height);
                    saveState();
                }
            });

            btnSave.addEventListener('click', () => {
                const link = document.createElement('a');
                link.download = `sketch_${Date.now()}.png`;
                link.href = canvas.toDataURL();
                link.click();
                
                toast.style.opacity = '1';
                setTimeout(() => {
                    toast.style.opacity = '0';
                }, 2000);
            });

            window.addEventListener('resize', () => {
                clearTimeout(window.resizeTimer);
                window.resizeTimer = setTimeout(resizeCanvas, 100);
            });
            
            resizeCanvas();
            updateUndoButton();
        });
    </script>
</body>
</html>