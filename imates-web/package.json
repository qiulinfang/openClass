{
  "name": "exerciseSolve",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.11.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:webview": "vite --config vite.config.webview.ts --host 0.0.0.0",
    "build": "run-p type-check \"build-only {@}\" --",
    "build:webview": "node scripts/build-webview-pages.js",
    "build:webview:debug": "NODE_ENV=development node scripts/build-webview-pages.js",
    "build:exercise": "node scripts/build-webview-pages.js exerciseSolve",
    "build:exercise:debug": "NODE_ENV=development node scripts/build-webview-pages.js exerciseSolve",
    "build:find": "node scripts/build-webview-pages.js findExercise",
    "build:find:debug": "NODE_ENV=development node scripts/build-webview-pages.js findExercise",
    "build:full": "run-p type-check \"build-full-only {@}\" --",
    "build:full:debug": "NODE_ENV=development run-p type-check \"build-full-only {@}\" --",
    "deploy": "node scripts/one-click-deploy.cjs",
    "deploy:exercise": "node scripts/one-click-deploy.cjs exercise",
    "deploy:find": "node scripts/one-click-deploy.cjs find",
    "deploy:full": "node scripts/one-click-deploy.cjs full",
    "deploy:full:debug": "node scripts/one-click-deploy.cjs full debug",
    "test:unit": "vitest",
    "test:e2e": "playwright test",
    "test:sourcemap": "node scripts/test-sourcemap.js",
    "lint": "eslint . --fix",
    "format": "prettier --write src/",
    "build-only": "vite build",
    "build-full-only": "vite build --outDir dist-full",
    "type-check": "vue-tsc --build"
  },
  "dependencies": {
    "@better-scroll/core": "^2.5.1",
    "@better-scroll/pull-down": "^2.5.1",
    "@capacitor/android": "^7.4.4",
    "@capacitor/app": "^7.1.0",
    "@capacitor/camera": "^7.0.2",
    "@capacitor/cli": "^7.4.4",
    "@capacitor/core": "^7.4.4",
    "@capacitor/device": "^7.0.2",
    "@capacitor/filesystem": "^7.1.4",
    "@capacitor/keyboard": "^7.0.3",
    "@capacitor/preferences": "^7.0.2",
    "@capacitor/status-bar": "^7.0.3",
    "@quasar/extras": "^1.17.0",
    "@tato30/vue-pdf": "^1.11.5",
    "@tiptap/core": "^3.4.2",
    "@tiptap/extension-color": "^3.4.2",
    "@tiptap/extension-image": "^3.4.2",
    "@tiptap/extension-link": "^3.4.2",
    "@tiptap/extension-placeholder": "^3.4.2",
    "@tiptap/extension-text-align": "^3.4.2",
    "@tiptap/extension-text-style": "^3.4.2",
    "@tiptap/extension-underline": "^3.4.2",
    "@tiptap/pm": "^3.4.2",
    "@tiptap/starter-kit": "^3.4.2",
    "@tiptap/vue-3": "^3.4.2",
    "@types/crypto-js": "^4.2.2",
    "crypto-js": "^4.2.0",
    "fabric": "^6.7.1",
    "konva": "^10.0.8",
    "localforage": "^1.10.0",
    "markdown-it": "^14.1.0",
    "markdown-it-mathjax3": "^4.3.2",
    "mathlive": "^0.107.0",
    "mpegts.js": "^1.7.7",
    "pdfjs-dist": "^5.4.296",
    "pinia": "^3.0.3",
    "quasar": "^2.18.2",
    "quill": "^2.0.2",
    "signature_pad": "^5.1.1",
    "vue": "^3.5.18",
    "vue-router": "^4.5.1",
    "vuedraggable": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.1",
    "@quasar/vite-plugin": "^1.10.0",
    "@tsconfig/node22": "^22.0.2",
    "@types/jsdom": "^21.1.7",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.16.5",
    "@types/quill": "^2.0.10",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vitejs/plugin-vue-jsx": "^5.0.1",
    "@vitest/eslint-plugin": "^1.3.4",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.7.0",
    "eslint": "^9.31.0",
    "eslint-plugin-playwright": "^2.2.0",
    "eslint-plugin-vue": "~10.3.0",
    "jiti": "^2.4.2",
    "jsdom": "^26.1.0",
    "npm-run-all2": "^8.0.4",
    "prettier": "3.6.2",
    "sass-embedded": "^1.91.0",
    "typescript": "~5.8.0",
    "vite": "^7.0.6",
    "vite-plugin-vue-devtools": "^8.0.0",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.0.4"
  }
}
