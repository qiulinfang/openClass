/* UniApp 全局 Sass 变量与工具类定义 */
.login-page.data-v-cdfe2409 {
  width: 100vw;
  height: 100vh;
  background-color: #4f46e5;
  background-linear-gradient: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  position: relative;
  box-sizing: border-box;
}
.login-form-container.data-v-cdfe2409 {
  width: 85%;
  max-width: 600rpx;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 40rpx 30rpx;
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.15);
}
.login-form-card.data-v-cdfe2409 {
  width: 100%;
}
.user-id-input-wrapper.data-v-cdfe2409,
.password-input-wrapper.data-v-cdfe2409 {
  width: 100%;
  margin-bottom: 24rpx;
}
.login-input-container.data-v-cdfe2409 {
  position: relative;
  display: flex;
  align-items: center;
  width: 100%;
  height: 80rpx;
  background-color: #f3f4f6;
  border-radius: 16rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
}
.login-input-container.has-error.data-v-cdfe2409 {
  border: 1px solid #ff4d4f;
}
.input-icon.data-v-cdfe2409 {
  font-size: 32rpx;
  margin-right: 12rpx;
}
.login-input.data-v-cdfe2409 {
  flex: 1;
  height: 100%;
  font-size: 28rpx;
  color: #333;
}
.account-dropdown-arrow.data-v-cdfe2409 {
  font-size: 20rpx;
  color: #888;
  padding: 10rpx;
}
.accounts-dropdown-list.data-v-cdfe2409 {
  position: absolute;
  top: 90rpx;
  left: 0;
  right: 0;
  background-color: #ffffff;
  border: 1px solid #e5e7eb;
  border-radius: 16rpx;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.1);
  max-height: 300rpx;
  z-index: 999;
}
.accounts-dropdown-item.data-v-cdfe2409 {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 20rpx;
  border-bottom: 1px solid #f0f0f0;
}
.accounts-dropdown-item.data-v-cdfe2409:last-child {
  border-bottom: none;
}
.account-name.data-v-cdfe2409 {
  font-size: 28rpx;
  color: #333;
}
.delete-account-btn.data-v-cdfe2409 {
  font-size: 24rpx;
  color: #999;
  padding: 10rpx;
}
.input-error.data-v-cdfe2409 {
  margin-top: 6rpx;
  color: #ff4d4f;
  font-size: 24rpx;
}
.login-button.data-v-cdfe2409 {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  margin-top: 30rpx;
  background-color: #6e55ff;
  color: #ffffff;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: 500;
  text-align: center;
}
.login-button[disabled].data-v-cdfe2409 {
  opacity: 0.6;
}
.error-banner.data-v-cdfe2409 {
  margin-top: 20px;
  color: #ff4d4f;
  font-size: 26rpx;
  text-align: center;
}
.version-text.data-v-cdfe2409 {
  position: absolute;
  bottom: 40rpx;
  color: rgba(255, 255, 255, 0.7);
  font-size: 24rpx;
}